#!/usr/bin/env python3
"""Print the wifi networks stored in pass as a JSON list (for Ansible).

Each pass entry under wifi/ is one network's iwd profile, verbatim (see
iwd.network(5)), named <SSID>.<psk|8021x|open> like iwd's own profile files.
The first-login playbook runs this on the machine itself and stores each
profile as an encrypted systemd credential
(roles/network_configuration/tasks/wifi-credentials.yml); nothing is baked into
the image. Run it directly to inspect what would be stored.

Output: [{"file": <iwd profile file name>, "profile": <entry body>}, ...]
"""
import glob
import json
import os
import re
import subprocess
import sys

store = os.path.expanduser(
    os.environ.get("PASSWORD_STORE_DIR") or "~/.local/share/password-store"
)
# On an installed or live system the store may only exist as the read-only copy
# the image ships (GPG-encrypted; the YubiKey decrypts it). bin/build-image
# falls back the same way.
if not os.environ.get("PASSWORD_STORE_DIR") and not os.path.isdir(store):
    store = "/usr/share/password-store"
    os.environ["PASSWORD_STORE_DIR"] = store

networks = []
for path in sorted(glob.glob(os.path.join(store, "wifi", "*.gpg"))):
    entry = os.path.basename(path)[:-4]
    ssid, _, kind = entry.rpartition(".")
    if not ssid or kind not in ("psk", "8021x", "open"):
        sys.exit(f"error: pass entry wifi/{entry} must be named SSID.psk, SSID.8021x or SSID.open")
    profile = subprocess.run(
        ["pass", "show", f"wifi/{entry}"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    # iwd names profiles by SSID, hex-encoded with a "=" prefix when it has
    # anything besides alphanumerics, space, "-" and "_".
    if not re.fullmatch(r"[A-Za-z0-9 _-]+", ssid):
        ssid = "=" + ssid.encode().hex()
    networks.append({"file": f"{ssid}.{kind}", "profile": profile})

json.dump(networks, sys.stdout)
