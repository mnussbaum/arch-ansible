#!/bin/bash
# ExecStartPre of iwd.service: write the iwd network profiles from the
# iwd.network.* credentials systemd imported and decrypted for the unit
# (store-wifi-credential made them) into iwd's state directory, which the
# drop-in points at a tmpfs, so plaintext PSKs never touch disk.
set -o errexit
set -o nounset
set -o pipefail

state="${STATE_DIRECTORY:?not run by iwd.service}"
creds="${CREDENTIALS_DIRECTORY:-}"

[[ -n "$creds" && -d "$creds" ]] || exit 0

shopt -s nullglob
for c in "$creds"/iwd.network.*; do
    profile="${c##*/iwd.network.}"
    install -m 0600 "$c" "$state/$profile"
done
