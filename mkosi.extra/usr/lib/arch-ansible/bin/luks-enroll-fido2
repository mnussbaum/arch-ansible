#!/bin/bash
# Enroll the YubiKey (FIDO2) on root and swap, authorized by their TPM2 slot.
# Run on the console at first boot by luks-enroll-fido2.service; safe to re-run
# by hand, since volumes that already have a FIDO2 slot are skipped.
set -o errexit
set -o nounset
set -o pipefail

wait_secs=${ENROLL_FIDO2_WAIT:-120}

say() { printf '\n==> %s\n' "$*"; }

has_fido2() { systemd-cryptenroll "$1" 2>/dev/null | grep -qw fido2; }
have_key() { systemd-cryptenroll --fido2-device=list 2>/dev/null | grep -q '^/dev/'; }

devices=()
for d in /dev/disk/by-designator/root-luks /dev/disk/by-designator/swap-luks; do
    [[ -e "$d" ]] && ! has_fido2 "$d" && devices+=("$d")
done
[[ ${#devices[@]} -gt 0 ]] || exit 0

if ! have_key; then
    say "Plug in your YubiKey to enroll it for disk unlock (waiting ${wait_secs}s)."
    for (( i = 0; i < wait_secs; i++ )); do
        have_key && break
        sleep 1
    done
fi
if ! have_key; then
    say "No YubiKey found; skipping. Enroll it later with: sudo $0"
    exit 0
fi

for dev in "${devices[@]}"; do
    name=${dev##*/}
    while true; do
        say "Enrolling the YubiKey for ${name%-luks}. Enter its FIDO2 PIN if asked," \
            "then TOUCH it each time it blinks."
        if systemd-cryptenroll "$dev" --unlock-tpm2-device=auto --fido2-device=auto; then
            say "YubiKey enrolled for ${name%-luks}."
            break
        fi
        read -rp "Enrollment failed. Press Enter to retry, or type s to skip: " reply
        [[ "$reply" == s ]] && { say "Skipped ${name%-luks}."; break; }
    done
done
