# Enroll a YubiKey (FIDO2) on the root volume at first boot, and get rid of the
# empty-key bootstrap slot 50-root.conf's Encrypt=key-file+tpm2 leaves behind.
# See bin/enroll-root-fido2 for why root needs a second factor at all (its TPM2
# token is a signed PCR 11 policy, so it only unlocks inside the initrd of a
# normal signed boot — never from a recovery medium).
#
# Ordered like systemd-homed-firstboot.service: first boot only, before anyone
# can log in, so the window in which an empty key opens root is as short as
# possible and the human who is sitting there at install time is the one asked
# for the YubiKey.
#
# NOT a hard boot dependency: if no key turns up the script wipes the empty slot
# anyway and warns loudly, leaving root TPM-only rather than blocking a machine
# whose YubiKey is simply elsewhere. It talks to tty1 because it has to prompt
# for a physical tap.
[Unit]
Description=Enroll a FIDO2 token on the root volume (first boot)
Documentation=man:systemd-cryptenroll(1)
ConditionFirstBoot=yes
ConditionPathExists=/usr/share/arch-ansible/bin/enroll-root-fido2
ConditionPathExists=/dev/disk/by-designator/root-luks
After=local-fs.target
Before=systemd-user-sessions.service first-boot-complete.target getty.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/share/arch-ansible/bin/enroll-root-fido2
TimeoutStartSec=300
StandardInput=tty
StandardOutput=tty
StandardError=journal+console
TTYPath=/dev/tty1
TTYReset=yes

[Install]
WantedBy=multi-user.target
