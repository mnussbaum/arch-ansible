# Enroll the YubiKey on root and swap at first boot, before anyone logs in.
# Replaces the interactive systemd-cryptenroll-firstboot wizard, which the
# kernel command line masks (mkosi.conf).
[Unit]
Description=Enroll YubiKey (FIDO2) for disk unlock
Documentation=man:systemd-cryptenroll(1)
ConditionFirstBoot=yes
# No FIDO2 passthrough in our VMs.
ConditionVirtualization=no
ConditionPathExists=/dev/disk/by-designator/root-luks
After=local-fs.target systemd-firstboot.service
Before=systemd-user-sessions.service first-boot-complete.target getty.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/arch-ansible/bin/luks-enroll-fido2
TimeoutStartSec=infinity
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes

[Install]
WantedBy=multi-user.target
