[Transfer]
ProtectVersion=%A

[Source]
Type=regular-file
Path=/var/lib/arch-ansible/updates
MatchPattern=%M_@v_%a.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=boot
MatchPattern=%M_@v_%a+@l-@d.efi \
             %M_@v_%a+@l.efi \
             %M_@v_%a.efi
Mode=0444
TriesLeft=3
TriesDone=0
InstancesMax=2
