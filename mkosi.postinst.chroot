#!/bin/bash
set -euo pipefail

[[ -n "${SKIP_POSTINST:-}" ]] && exit 0

chmod -R a+rX /usr/share/arch-ansible /usr/share/password-store

cd /work/src
export USER=root HOME=/root

# Reference point for mkosi.finalize's cache write-back: it ships yay/cargo/
# sccache files created after this back to the host (everything older was seeded
# in via SkeletonTrees). Dropped here, after the incremental cache restore, so it
# reliably predates anything this postinst builds regardless of restore mtimes.
touch /root/.cache-writeback-since

# Seed yay's clone dir (/var/cache/yay; yay uses that path when running as root)
# from the host cache. The SkeletonTree seeds the same data into the incremental
# snapshot, but writebacks since the snapshot was created aren't visible there.
# This rsync brings in the delta: --ignore-existing skips what's already in the
# image (snapshot-seeded content stays) and only adds entries that are newer on
# the host (e.g. sources downloaded by a previous build's yay and written back).
mkdir -p /var/cache/yay
rsync -a --ignore-existing /work/src/yay-cache/ /var/cache/yay/ 2>/dev/null || true

extra_args=()
if [[ -n "${ANSIBLE_EXTRA_ARGS:-}" ]]; then
  eval "extra_args=($ANSIBLE_EXTRA_ARGS)"
fi

# Carry the build's cache policy (bin/build-image --caching) into the postinst so
# its pacman/yay match the package-install phase. build_caching feeds the
# pacman.conf template's cache-only XferCommand (force); for a full refresh we
# resync the chroot's package DB here, since the image's /var/lib/pacman/sync is
# seeded, not the DB mkosi refreshed for its own install. 'available' keeps the
# default behaviour (no resync; download only what the cache is missing).
caching="${CACHING:-available}"
extra_args+=(--extra-vars "build_caching=$caching")
if [[ "$caching" == off ]]; then
  pacman -Syy --noconfirm
fi

: "${ANSIBLE_WIFI_NETWORKS:?must be set by bin/build-image (from bin/wifi-networks)}"
wifi_networks=$(printf '%s' "$ANSIBLE_WIFI_NETWORKS" | base64 -d)
extra_args+=(--extra-vars "{\"wifi_networks\": $wifi_networks}")

SCCACHE_SERVER_PORT=14226 sccache --stop-server 2>/dev/null || true
SCCACHE_NO_DAEMON=1 SCCACHE_DIR=/root/.cache/sccache \
    SCCACHE_SERVER_PORT=14226 sccache --start-server &
trap "SCCACHE_SERVER_PORT=14226 sccache --stop-server 2>/dev/null || true" EXIT

# Build against the dedicated build identity supplied via mkosi --profile (the
# $PROFILES env var, e.g. host_vars/build.yml), not the per-machine $IMAGE_ID,
# so machine-specific vars stay out of the shared image.
env NO_ASK_BECOME_PASS=1 HOSTNAME="$PROFILES" ANSIBLE_PLAYBOOK=postinst-playbook.yml \
    SCCACHE_SERVER_PORT=14226 \
    ./bin/ansible "${extra_args[@]}" ${ANSIBLE_TAGS:+--tags "$ANSIBLE_TAGS"}
