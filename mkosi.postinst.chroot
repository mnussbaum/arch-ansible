#!/bin/bash
set -euo pipefail

[[ -n "${SKIP_POSTINST:-}" ]] && exit 0

chmod -R a+rX /usr/share/arch-ansible /usr/share/password-store

cd /work/src
export USER=root HOME=/root

# Reference point for mkosi.finalize's cache write-back: it ships yay/cargo/
# sccache files created after this back to the host (everything older was seeded
# in via SkeletonTrees). Dropped here, after the incremental cache restore, so it
# reliably predates anything this postinst builds regardless of restore mtimes.
touch /root/.cache-writeback-since

# Seed yay's clone dir (/var/cache/yay; setup-aur.yml pins yay's buildDir to it,
# so root-run yay builds here despite HOME=/root) from the host cache. The
# SkeletonTree seeds the same data into the incremental
# snapshot, but writebacks since the snapshot was created aren't visible there.
# This rsync brings in the delta: --ignore-existing skips what's already in the
# image (snapshot-seeded content stays) and only adds entries that are newer on
# the host (e.g. sources downloaded by a previous build's yay and written back).
mkdir -p /var/cache/yay
rsync -a --ignore-existing /work/src/yay-cache/ /var/cache/yay/ 2>/dev/null || true

# Same delta-seed for neovim's plugin/parser dir: the SkeletonTree froze the host
# cache into the snapshot; this brings in anything written back since (e.g. plugins
# a previous build fetched). The neovim role's headless install then finds these
# present and skips re-fetching them. -a preserves mtimes so seeded files stay
# older than the writeback marker and aren't re-staged by mkosi.finalize.
mkdir -p /etc/skel/.local/share/nvim/site
rsync -a --ignore-existing /work/src/nvim-site/ /etc/skel/.local/share/nvim/site/ 2>/dev/null || true

# Same delta-seed for the local AUR repo. The SkeletonTree froze the host cache
# into the snapshot; this brings in packages a previous online build wrote back
# since. Nothing INSTALLS from here any more — mkosi does that from the host
# copy via PackageDirectories= — but the postinst's `yay -Sua` builds into it
# (PKGDEST) and mkosi.finalize writes the new packages back to the host.
mkdir -p /var/cache/aur-repo
rsync -a --ignore-existing /work/src/aur-repo/ /var/cache/aur-repo/ 2>/dev/null || true

# Delta-seed cargo's registry cache — the downloaded .crate archives (cache/) and
# the registry index (index/) — from the host writebacks-since, then drop the
# extracted src/ tree. cargo extracts each .crate into src/ preserving the
# archive's stored (old) mtimes, so it can't round-trip through the finalize
# -newer delta: that writes back an empty src/<crate>/ dir, which makes cargo skip
# re-extraction and then fail reading the absent Cargo.toml ("No such file"). src/
# is fully rebuildable from the round-tripped cache/, so wipe whatever the snapshot
# and seed carried (both may hold those poisoned empty dirs) and let cargo
# re-extract cleanly from the .crate archives this build.
mkdir -p /root/.cargo/registry
rsync -a --ignore-existing /work/src/cargo-registry/ /root/.cargo/registry/ 2>/dev/null || true
rm -rf /root/.cargo/registry/src

# Same delta-seed for sccache's compilation cache. Unlike cargo a stale sccache
# never hard-fails (a missing entry is just a cache miss -> recompile), but the
# frozen snapshot alone still misses every object a previous build wrote back,
# so those recompiles are wasted. This brings the writebacks-since in so cache
# hits actually land; --ignore-existing keeps snapshot-seeded content untouched.
mkdir -p /root/.cache/sccache
rsync -a --ignore-existing /work/src/sccache-cache/ /root/.cache/sccache/ 2>/dev/null || true

extra_args=()
if [[ -n "${ANSIBLE_EXTRA_ARGS:-}" ]]; then
  eval "extra_args=($ANSIBLE_EXTRA_ARGS)"
fi

# Carry the build's cache policy (bin/build-image --caching) into the postinst so
# its pacman/yay match the package-install phase. build_caching feeds the
# pacman.conf template's cache-only XferCommand (force); for a full refresh we
# resync the chroot's package DB here, since the image's /var/lib/pacman/sync is
# seeded, not the DB mkosi refreshed for its own install. 'available' keeps the
# default behaviour (no resync; download only what the cache is missing).
caching="${CACHING:-available}"
extra_args+=(--extra-vars "build_caching=$caching")
if [[ "$caching" == off ]]; then
  # --disable-sandbox: this runs before Ansible templates the pacman.conf that
  # sets DisableSandbox, and the stock config's DownloadUser cannot be chowned to
  # inside mkosi's user namespace ("failed to chown temporary download directory").
  pacman -Syy --noconfirm --disable-sandbox
fi

: "${ANSIBLE_WIFI_NETWORKS:?must be set by bin/build-image (from bin/wifi-networks)}"
wifi_networks=$(printf '%s' "$ANSIBLE_WIFI_NETWORKS" | base64 -d)
extra_args+=(--extra-vars "{\"wifi_networks\": $wifi_networks}")

SCCACHE_SERVER_PORT=14226 sccache --stop-server 2>/dev/null || true
SCCACHE_NO_DAEMON=1 SCCACHE_DIR=/root/.cache/sccache \
    SCCACHE_SERVER_PORT=14226 sccache --start-server &
trap "SCCACHE_SERVER_PORT=14226 sccache --stop-server 2>/dev/null || true" EXIT

# Build against the dedicated `build` identity supplied via mkosi --profile (the
# $PROFILES env var), not the per-machine $IMAGE_ID, so machine-specific vars stay
# out of the shared image. (bin/ansible reads ARCH_ANSIBLE_IDENTITY, not HOSTNAME,
# which bash auto-sets.)
env NO_ASK_BECOME_PASS=1 ARCH_ANSIBLE_IDENTITY="$PROFILES" ANSIBLE_PLAYBOOK=postinst-playbook.yml \
    SCCACHE_SERVER_PORT=14226 \
    ./bin/ansible "${extra_args[@]}" ${ANSIBLE_TAGS:+--tags "$ANSIBLE_TAGS"}
