[Unit]
Description=Apply output profiles when monitors are plugged in
Documentation=man:kanshi(1) man:kanshi(5)
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/kanshi --config /etc/kanshi/config
ExecReload=/usr/bin/kanshictl reload
Restart=on-failure
RestartSec=1
TimeoutStopSec=10

[Install]
WantedBy=sway-session.target
