[Match]
# Match wired (en*) and wireless (wl*) NICs by name so one image works on any
# host (e.g. qemu's enp0s1, laptops' wlan0/wlp*) without baking an interface
# name in. Excludes virtual interfaces (docker0, veth*, br-*, wg*, tun*).
Name=en* wl*

[Network]
DHCP=yes
IPv6AcceptRA=yes
IgnoreCarrierLoss=3s
KeepConfiguration=dhcp-on-stop

[Link]
RequiredForOnline=routable
RequiredFamilyForOnline=ipv4

[IPv6AcceptRA]
DHCPv6Client=yes
# A stable address per prefix, so it survives roaming between APs. Not a fixed
# ::1 suffix: routers often hold ::1, so DAD kept removing ours.
Token=prefixstable
