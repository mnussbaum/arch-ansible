[Unit]
Description=Automount removable drives through udisks2
Documentation=man:udiskie(8)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Waybar has no tray module, so mount/unmount actions live on the notifications
# Never pop up a password dialog; encrypted drives are left locked
ExecStart=/usr/bin/udiskie --automount --notify --no-tray --no-password-prompt
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
