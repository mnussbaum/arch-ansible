#!/bin/bash

set -o errexit
set -o nounset

print_status() {
  local cards
  cards=$(pactl list cards)

  if grep -q "Active Profile: a2dp-sink" <<< "$cards" ; then
    printf "󰋋🎶\n"
  elif grep -q "Active Profile: headset-head-unit" <<< "$cards" ; then
    printf "󰋋󰍮\n"
  else
    printf "󰟎\n"
  fi
}

print_status

# Reprint on card events (profile switches, headsets connecting) instead of polling
pactl subscribe | while read -r event ; do
  if [[ $event == *" on card "* ]] ; then
    print_status
  fi
done
