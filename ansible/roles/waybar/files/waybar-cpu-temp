#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail

# Find the CPU package sensor by name rather than a hardcoded index, since the
# index varies per machine: Intel's x86_pkg_temp thermal zone, else AMD's
# k10temp hwmon (Tctl), else the first thermal zone.
temp_file=""
for type_file in /sys/class/thermal/thermal_zone*/type; do
  if [[ "$(cat "$type_file")" == x86_pkg_temp ]]; then
    temp_file="${type_file%/type}/temp"
    break
  fi
done

if [[ -z "$temp_file" ]]; then
  for name_file in /sys/class/hwmon/hwmon*/name; do
    if [[ "$(cat "$name_file")" == k10temp ]]; then
      temp_file="${name_file%/name}/temp1_input"
      break
    fi
  done
fi

if [[ -z "$temp_file" ]]; then
  temp_file="$(echo /sys/class/thermal/thermal_zone*/temp | cut -d' ' -f1)"
fi

[[ -r "$temp_file" ]] || exit 0

milli_celsius=$(cat "$temp_file")
fahrenheit=$(( milli_celsius * 9 / 5000 + 32 ))

printf "%d\n" "$fahrenheit"
