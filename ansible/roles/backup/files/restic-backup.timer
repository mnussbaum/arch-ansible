[Unit]
Description=Run restic backup daily
# Organization images don't back up home. A missing key fails a plain
# "=" match, hence the negated glob.
ConditionOSRelease=ARCH_ANSIBLE_ORGANIZATIONS!$=?*

[Timer]
OnCalendar=daily
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
