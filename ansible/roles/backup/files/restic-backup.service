[Unit]
Description=Restic backup
Wants=network.target
Requires=pass-credential@restic_backup_password.socket
After=network.target pass-credential@restic_backup_password.socket
ConditionPathIsMountPoint=/home/%u

[Service]
Type=oneshot
LoadCredential=restic_backup_password:%t/pass-credential-restic_backup_password.socket
ExecStart=/usr/bin/restic-backup backup
