[Unit]
Description=Firefox (%i profile)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# User units can't order after the system's network-online.target, so wait
# here; otherwise restored tabs load offline. "-": start offline after the
# timeout rather than not at all.
ExecStartPre=-/usr/lib/systemd/systemd-networkd-wait-online --any --timeout=60
# Matches the firefox-%i.desktop launcher, so links reach this instance
ExecStart=/usr/bin/firefox -P %i --name firefox-%i

[Install]
WantedBy=graphical-session.target
