[Unit]
Description=Forward systemd-ask-password requests to zenity in the active graphical session
Wants=systemd-ask-password-wall.path

[Service]
ExecStart=/usr/bin/ask-password-agent
Restart=on-failure
RestartSec=2
# Local sockets only. zenity's GTK may probe netlink, so families aren't
# restricted.
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
