/* User-level GTK3 overrides for the systemd-ask-password zenity dialog.
   Loaded by setting XDG_CONFIG_HOME to /etc/ask-password-agent when zenity
   runs, so it layers on top of Adwaita (kept as the base theme so widgets
   render properly) and just repaints with the active base16 palette. */

@define-color theme_bg_color           #{{ color_scheme_vars['base00-hex'] }};
@define-color theme_fg_color           #{{ color_scheme_vars['base05-hex'] }};
@define-color theme_base_color         #{{ color_scheme_vars['base01-hex'] }};
@define-color theme_text_color         #{{ color_scheme_vars['base05-hex'] }};
@define-color theme_selected_bg_color  #{{ color_scheme_vars['base0D-hex'] }};
@define-color theme_selected_fg_color  #{{ color_scheme_vars['base00-hex'] }};

@define-color theme_unfocused_bg_color #{{ color_scheme_vars['base00-hex'] }};
@define-color theme_unfocused_fg_color #{{ color_scheme_vars['base05-hex'] }};
@define-color theme_unfocused_base_color #{{ color_scheme_vars['base01-hex'] }};

@define-color insensitive_bg_color     #{{ color_scheme_vars['base01-hex'] }};
@define-color insensitive_fg_color     #{{ color_scheme_vars['base03-hex'] }};
@define-color insensitive_base_color   #{{ color_scheme_vars['base01-hex'] }};

@define-color borders                  #{{ color_scheme_vars['base02-hex'] }};
@define-color unfocused_borders        #{{ color_scheme_vars['base02-hex'] }};

@define-color content_view_bg          #{{ color_scheme_vars['base00-hex'] }};
@define-color warning_color            #{{ color_scheme_vars['base09-hex'] }};
@define-color error_color              #{{ color_scheme_vars['base08-hex'] }};
@define-color success_color            #{{ color_scheme_vars['base0B-hex'] }};
