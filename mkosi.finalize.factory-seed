#!/bin/bash
# Move /etc contents into /usr/share/factory/etc and generate tmpfiles.d rules
# that symlink /etc back into factory on first boot. This makes /etc *track*
# /usr across A/B updates instead of freezing at first boot.
#
# Runs as a FinalizeScript (host-side, operating on $BUILDROOT) rather than a
# PostInstallationScript so it runs AFTER mkosi's own /etc processing —
# systemd-sysusers, volatile-file generation, `systemctl preset-all`, and
# first-boot settings. Gutting /etc before preset-all (as a postinst script
# did) breaks preset-all, which needs a writable /etc to create enablement
# symlinks. By the time finalize runs, those symlinks already exist in
# $BUILDROOT/etc and get carried into factory along with everything else.
#
# Per-host state (machine-id, ssh host keys, shadow) is generated by stock
# systemd services into the writable /etc on first boot and replaces the
# symlinks at those specific paths.

set -euo pipefail

[[ -n "${SKIP_POSTINST:-}" ]] && exit 0

ETC="$BUILDROOT/etc"
FACTORY="$BUILDROOT/usr/share/factory/etc"
TMPFILES="$BUILDROOT/usr/lib/tmpfiles.d/00-factory-etc.conf"

# Top-level /etc entries left in place (NOT moved to factory). Keep short and
# document each entry.
ALLOWLIST=(
    # resolv.conf is a symlink into /run (systemd-resolved stub) — runtime
    # state that belongs on the writable root, not the read-only factory tree.
    resolv.conf
)

# Top-level /etc entries removed entirely: build-time-only secrets and state
# the running system regenerates on first boot.
DROPLIST=(
    # ukify's signing private key — used at build time, must not ship
    kernel/secure-boot-private-key.pem
    # pacman keyring — regenerated on first boot; shipping the build-host
    # keyring would tie every machine to one trustdb
    pacman.d/gnupg
    # makepkg.conf is mutated for the nspawn build chroot; those mutations
    # must not persist. The running system doesn't invoke makepkg/yay.
    makepkg.conf
)

is_listed() {
    local needle="$1" hay
    shift
    for hay in "$@"; do
        [[ "$needle" == "$hay" || "$needle" == "$hay"/* ]] && return 0
    done
    return 1
}

# Skip allowlisted entries and any mkosi has bind-mounted (a bind mount can't
# be moved, and its content is transient build infra).
should_skip() {
    local entry="$1" name
    name=$(basename "$entry")
    is_listed "$name" "${ALLOWLIST[@]}" && return 0
    mountpoint -q "$entry" && return 0
    return 1
}

for rel in "${DROPLIST[@]}"; do
    rm -rf -- "$ETC/$rel"
done

mkdir -p "$FACTORY" "$(dirname "$TMPFILES")"

{
    echo "# Auto-generated by mkosi.finalize.factory-seed"
    echo "# Symlinks /etc/<thing> -> /usr/share/factory/etc/<thing>."
    echo "# Using L (symlink) lines, not C (copy), so /etc tracks /usr across"
    echo "# A/B updates. The trailing '-' makes tmpfiles compute the canonical"
    echo "# /usr/share/factory/<path> target automatically."
    echo ""
} > "$TMPFILES"

shopt -s nullglob dotglob
for entry in "$ETC"/*; do
    name=$(basename "$entry")
    should_skip "$entry" && continue
    mv "$entry" "$FACTORY/$name"
    printf 'L /etc/%s - - - - -\n' "$name" >> "$TMPFILES"
done

# Sanity: assert /etc is empty modulo skipped entries.
remaining=()
while IFS= read -r -d '' path; do
    should_skip "$path" && continue
    remaining+=("$(basename "$path")")
done < <(find "$ETC" -mindepth 1 -maxdepth 1 -print0)

if (( ${#remaining[@]} )); then
    echo "ERROR: /etc not empty after factory conversion:" >&2
    printf '  /etc/%s\n' "${remaining[@]}" >&2
    exit 1
fi
