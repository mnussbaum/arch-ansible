#!/bin/bash
# Build a fresh image version locally and apply it to an inactive A/B /usr slot
# via systemd-sysupdate, then optionally reboot. There is no update server: the
# new version is built from this repo. Two modes:
#
#   (default) On-device update — run it ON the target device (whose /usr is the
#     read-only dm-verity image). It rebuilds, stages the split artifacts to the
#     local source dir /var/lib/arch-ansible/updates (replacing the previous
#     build), then `systemd-sysupdate --transfer-source=<staging>` installs them
#     to the device's inactive slot. Refuses to run where /usr isn't the
#     dissected image, so it can't touch an unrelated host.
#
#   --image=DISK  Offline update of another system's disk — run it from a live
#     USB against an installed-but-not-running target (e.g. a laptop too broken
#     to update itself). It rebuilds, then retargets systemd-sysupdate at the
#     target disk via the volatile-root mechanism (NOT `--image` — see below) and
#     installs the freshly built artifacts to the target's inactive /usr slot,
#     writing the new UKI to the target's own ESP. Only the usr* partitions and
#     the ESP are touched; the TPM2-sealed LUKS root/home/swap are left intact, so
#     user data (homed volumes under /home) survives. The on-device guard,
#     device-target build env, and staging step are skipped.
#
# Both modes drive systemd-sysupdate directly (not updatectl/systemd-sysupdated):
# the transfers use PathRelativeTo=explicit, so the source must be supplied with
# --transfer-source, which updatectl can't pass. Both also use the host-side
# definitions in mkosi/mkosi.sysupdate/ (via --definitions), not the in-image
# /usr/lib/sysupdate.d copy. Boot counting / auto-rollback is unaffected — it
# lives in the UKI's TriesLeft= (see mkosi/mkosi.sysupdate/20-uki), not in the update
# daemon. Both modes need a writable checkout of this repo and `pass`/GPG for the
# build's signing keys.
#
# Why volatile-root instead of `systemd-sysupdate --image=DISK`: through systemd
# 261 the --image code path fails to parse our Type=regular-file transfers (it
# rejects Type= at the [Source] header), while the very same transfers parse fine
# via --definitions. So instead we point /run/systemd/volatile-root at a partition
# on the target disk: systemd then skips its root-block-device auto-detection and
# (walking up to that partition's whole disk) treats it as the system disk,
# matching the usr A/B partitions on it by type. Nothing
# is dissected, so the sealed LUKS partitions are never unlocked (no passphrase
# prompt). The UKI transfer (PathRelativeTo=boot) is aimed at the target's ESP by
# mounting it and exporting SYSTEMD_ESP_PATH, so it doesn't land on the live
# medium's own ESP. (mkosi uses volatile-root for its tools-tree case but against
# the *running* disk + ESP; retargeting a separate offline disk is our own use.)

set -o errexit
set -o nounset
set -o pipefail

reboot=""
image=""
no_build=""
build_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      echo "Build a new image version and apply it to an inactive /usr slot." >&2
      echo "Usage: $0 [--reboot] [--image=DISK] [build-image options...]" >&2
      echo "  --reboot      Reboot into the new slot after applying (on-device mode only)." >&2
      echo "  --image=DISK  Offline-update another system's disk/raw image instead of this" >&2
      echo "                device (live-USB mode). Updates only its inactive /usr slot and" >&2
      echo "                ESP; leaves root/home/swap intact." >&2
      echo "  --no-build    Apply the image bin/build-image last built instead of rebuilding." >&2
      echo "  Other options are forwarded to build-image (e.g. --ansible-tags TAGS)." >&2
      echo "  Rebuilds with the running image's organizations unless --organization is given." >&2
      exit
      ;;
    --reboot) reboot=1 ;;
    --image=*) image="${1#*=}" ;;
    --image) image="$2"; shift ;;
    --no-build) no_build=1 ;;
    *) build_args+=("$1") ;;
  esac
  shift
done

if [[ -n "$reboot" && -n "$image" ]]; then
  echo "Refusing: --reboot updates the running system; it has no meaning with --image." >&2
  exit 1
fi

if [[ -n "$no_build" && ${#build_args[@]} -gt 0 ]]; then
  echo "Refusing: --no-build skips build-image, so it can't take its options: ${build_args[*]}" >&2
  exit 1
fi

# Validate the offline target up front: must be a block device or a raw image
# file. It's treated as a whole GPT disk (volatile-root needs a block device, so
# a file is loop-mounted below), and a partition or missing path would fail deep
# inside the apply step.
if [[ -n "$image" && ! -b "$image" && ! -f "$image" ]]; then
  echo "Refusing: --image target '$image' is not a block device or a file." >&2
  exit 1
fi

cd "$(dirname "$0")/.."

source bin/_build_context_common.sh

if [[ -z "$image" ]]; then
  # Guard: on-device apply only where /usr is the dissected verity image, i.e. an
  # actual hermetic device. On a build host /usr is btrfs on the root fs, and
  # sysupdate there could match unrelated partitions. (--image targets a separate
  # disk, so the running system's /usr is irrelevant — skip the guard in that mode.)
  usr_src=$(findmnt -no SOURCE /usr 2>/dev/null || true)
  if [[ "$usr_src" != /dev/mapper/usr ]]; then
    echo "Refusing: /usr is '$usr_src', not /dev/mapper/usr." >&2
    echo "Run update-system on the target device, or pass --image=DISK." >&2
    exit 1
  fi
fi

# Device vs host build context (and a live medium's scratch, created here if
# missing), shared with bin/build-image and bin/burn-image so all three agree on
# where images live. --image runs on the live medium, so it lands on the device
# target too. bin/build-image seeds the device caches and defaults the
# organizations to the running image's.
arch_ansible_select_build_target --provision
source bin/_cache_common.sh

if [[ -z "$no_build" ]]; then
  bin/build-image "${build_args[@]}"
fi

output_dir="$ARCH_ANSIBLE_OUTPUT_DIR"
# The version build-image just bumped to (mkosi/mkosi.bump > mkosi/mkosi.version). We pass it
# explicitly to `systemd-sysupdate update` below so a no-op can't pass silently: if
# sysupdate can't discover this exact version in the source it exits non-zero (vs.
# bare `update`, which prints "No update needed" and exits 0), and errexit aborts
# before any reboot.
new_version=$(cat mkosi/mkosi.version)

# With --no-build, take the version from the built UKI instead: build-image bumps
# mkosi.version before building, so a failed build leaves it ahead of the output.
# Versions are zero-padded timestamps, so the last in sort order is the newest.
if [[ -n "$no_build" ]]; then
  new_version=$(find "$output_dir" -maxdepth 1 -name 'image_*_*.efi' -printf '%f\n' 2>/dev/null |
    sed 's/^image_\([^_]*\)_.*/\1/' | sort | tail -n 1)
  if [[ -z "$new_version" ]]; then
    echo "Refusing: no built image in $output_dir. Run bin/build-image first." >&2
    exit 1
  fi
  echo "Applying previously built image version $new_version." >&2
fi

if [[ -n "$image" ]]; then
  # Offline path: apply the freshly built artifacts to the target disk's inactive
  # /usr slot via the volatile-root mechanism (see the header for why not
  # --image). --transfer-source points the transfers at our build output (no
  # staging copy needed). The binary isn't on PATH.

  # volatile-root needs a block device. A raw image file is loop-mounted (-P so
  # its partitions get device nodes); a real disk node is used as-is. Everything
  # acquired below is torn down on exit (the loop device detached, scratch dirs
  # removed); the bind/ESP mounts live in the mount namespace and vanish with it.
  loopdev="" runtmp="" esp_mnt=""
  cleanup() {
    [[ -n "$runtmp" ]] && rm -rf "$runtmp"
    [[ -n "$esp_mnt" ]] && rm -rf "$esp_mnt"
    [[ -n "$loopdev" ]] && sudo losetup -d "$loopdev"
  }
  trap cleanup EXIT

  target="$image"
  if [[ ! -b "$image" ]]; then
    loopdev=$(sudo losetup --find --partscan --show "$image")
    target="$loopdev"
  fi
  sudo udevadm settle

  # Find the target's ESP partition (type GUID per the Discoverable Partitions
  # Spec). We mount it below so the UKI transfer writes there, not to the live
  # medium's ESP. There's no XBOOTLDR partition (see repart.d), so the UKI's
  # PathRelativeTo=boot resolves to this ESP.
  esp_part=$(lsblk -rno PATH,PARTTYPE "$target" |
    awk 'tolower($2)=="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"{print $1; exit}')
  if [[ -z "$esp_part" ]]; then
    echo "Refusing: no ESP partition found on '$image'." >&2
    exit 1
  fi

  # The volatile-root symlink (bind-mounted over /run/systemd inside a throwaway
  # mount namespace, so the live system's real /run/systemd is untouched — the
  # live root is itself volatile and may already use volatile-root) and the
  # target ESP mountpoint.
  #
  # volatile-root must point at a *partition* on the target, NOT the whole disk:
  # sysupdate (resource_resolve_path, Path=auto) stat()s the symlink and feeds
  # the resolved block device to block_get_whole_disk(), which walks up from a
  # partition to its parent disk — but returns "not a partition" (and errors) if
  # handed a whole disk. So we point it at the ESP partition; sysupdate derives
  # the whole disk and enumerates the usr A/B partitions on it by type. (mkosi
  # points it at `bootctl --print-root-device`, likewise a partition.)
  runtmp=$(mktemp -d)
  esp_mnt=$(mktemp -d)
  ln -s "$esp_part" "$runtmp/volatile-root"

  # Run sysupdate in a private mount namespace: the volatile-root bind and the
  # ESP mount live only there and vanish with it (nothing leaks into the live
  # system). SYSTEMD_ESP_PATH + RELAX_ESP_CHECKS make sysupdate write the UKI to
  # the target ESP we mounted instead of scanning the live system's mount points.
  sudo unshare --mount --propagation private -- \
    bash -c '
      set -o errexit
      mount --bind "$1" /run/systemd
      mount "$2" "$3"
      export SYSTEMD_ESP_PATH="$3" SYSTEMD_RELAX_ESP_CHECKS=1
      exec /usr/lib/systemd/systemd-sysupdate \
        --definitions="$4" \
        --transfer-source="$5" \
        update "$6"
    ' bash "$runtmp" "$esp_part" "$esp_mnt" "$PWD/mkosi/mkosi.sysupdate" "$output_dir" "$new_version"
else
  staging=/var/lib/arch-ansible/updates

  # Stage only the split artifacts the transfers consume (usr data/hash/sig +
  # UKI), replacing any previous build so the source advertises exactly the new
  # version.
  sudo install -d -m 0755 "$staging"
  sudo find "$staging" -mindepth 1 -delete
  sudo cp -t "$staging" "$output_dir"/*.usr-*.raw "$output_dir"/image_*_*.efi

  # Apply to the inactive slot, then (optionally) reboot into it. Direct
  # systemd-sysupdate, not updatectl/systemd-sysupdated: the transfers now use
  # PathRelativeTo=explicit (shared with the --image path), so their source must
  # come from --transfer-source, which updatectl has no way to pass. sysupdate
  # auto-discovers the running system's disk and writes the new version to the
  # inactive usr slot; the guard above (we're on a real device) keeps that
  # discovery off a build host's disk.
  sudo /usr/lib/systemd/systemd-sysupdate --transfer-source="$staging" update "$new_version"
  if [[ -n "$reboot" ]]; then sudo systemctl reboot; fi
fi
