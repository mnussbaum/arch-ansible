#!/bin/bash

set -o errexit
set -o nounset

refresh_cache=""
dev_format=""
skip_postinst=""
ansible_tags=""
positional=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      echo "Build a fully provisioned persistent image for a specific host." >&2
      echo "Usage: $0 [--refresh-cache] [--dev] [--skip-postinst] [--ansible-tags TAGS] <hostname> [output-device]" >&2
      echo "  For hostname 'qemu', output goes to ~/.cache/mkosi/images/qemu/." >&2
      echo "  For physical hosts, output device is required." >&2
      echo "  --refresh-cache      Bust the mkosi incremental cache and do a full rebuild." >&2
      echo "  --dev                Build a directory tree instead of a disk image for faster iteration." >&2
      echo "  --skip-postinst      Skip the Ansible post-installation step." >&2
      echo "  --ansible-tags TAGS  Limit Ansible to specific tags (e.g. min-user-session)." >&2
      exit
      ;;
    --refresh-cache) refresh_cache="--incremental=no" ;;
    --dev) dev_format="--format=directory" ;;
    --skip-postinst) skip_postinst="--environment=SKIP_POSTINST=1" ;;
    --ansible-tags) ansible_tags="--environment=ANSIBLE_EXTRA_ARGS=--tags $2"; shift ;;
    *) positional+=("$1") ;;
  esac
  shift
done

mkdir -p ~/.cache/mkosi/pacman-pkg

hostname="${positional[0]:?Usage: $0 <hostname> [output]}"

luks_passphrase=$(
  ansible-vault view group_vars/all/secrets.yml \
    --vault-password-file secrets/vault-password \
    | python3 -c "import sys,yaml; d=yaml.safe_load(sys.stdin); print(d['luks_passphrase'])"
)

if [[ "$hostname" == "qemu" ]]; then
  source bin/_qemu_common.sh
  mkdir -p "$qemu_output_dir"
  mkosi \
    --directory="mkosi.images/$hostname" \
    --output-directory="$qemu_output_dir" \
    --credential="luks.passphrase=$luks_passphrase" \
    --force \
    ${refresh_cache:+"$refresh_cache"} \
    ${dev_format:+"$dev_format"} \
    ${skip_postinst:+"$skip_postinst"} \
    ${ansible_tags:+"$ansible_tags"}
else
  output="${positional[1]:?Usage: $0 <hostname> <output-device>}"
  output_dir=~/.cache/mkosi/images/$hostname
  mkdir -p "$output_dir"
  mkosi \
    --directory="mkosi.images/$hostname" \
    --output-directory="$output_dir" \
    --credential="luks.passphrase=$luks_passphrase" \
    --force \
    ${refresh_cache:+"$refresh_cache"} \
    ${dev_format:+"$dev_format"} \
    ${skip_postinst:+"$skip_postinst"} \
    ${ansible_tags:+"$ansible_tags"} \
    burn "$output"
fi
