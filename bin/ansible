#! /bin/bash

set -o errexit
set -o nounset

if command -v day-or-night > /dev/null ; then
  appearance=$(day-or-night)
else
  appearance="daytime"
 fi

maybe_ask_become_pass=""
if [[ -z "${NO_ASK_BECOME_PASS:-}" ]] ; then
  maybe_ask_become_pass="--ask-become-pass"
fi

# ansible.cfg, hosts.yml and the playbooks live in ansible/
cd "$(dirname "$0")/../ansible"

# Compile pyc files to avoid race condition errors on initial run compiling
# concurrent roles
ansible --version >/dev/null 2>&1

# The build sets ARCH_ANSIBLE_IDENTITY to pick its identity from ansible/hosts.yml. With none
# set, an installed machine provisions itself via localhost, regardless of its name
# (not HOSTNAME -- bash auto-sets that to the machine name). ansible/group_vars/all still apply.
if [[ -n "${ARCH_ANSIBLE_IDENTITY:-}" ]]; then
  target=(--limit "$ARCH_ANSIBLE_IDENTITY")
else
  target=(--inventory localhost, --connection local)
fi

# The image's organizations: set by the build, otherwise recorded in os-release
# by the organizations role.
if [[ -z "${ARCH_ANSIBLE_ORGANIZATIONS+set}" && -r /usr/lib/os-release ]]; then
  ARCH_ANSIBLE_ORGANIZATIONS=$(. /usr/lib/os-release; echo "${ARCH_ANSIBLE_ORGANIZATIONS:-}")
fi
organizations_json=$(python3 -c 'import json,sys;print(json.dumps({"image_organizations":[o for o in sys.argv[1].split(",") if o]}))' \
  "${ARCH_ANSIBLE_ORGANIZATIONS:-}")

exec ansible-playbook "${ANSIBLE_PLAYBOOK:-postinst-playbook.yml}" \
  --verbose \
  "${target[@]}" \
  --extra-vars "appearance=$appearance" \
  --extra-vars "$organizations_json" \
  "$@" \
  $maybe_ask_become_pass
