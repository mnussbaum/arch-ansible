#!/usr/bin/env python3
"""Print the wifi networks stored in pass as a JSON list (for Ansible).

Wifi config lives entirely in pass: one entry per SSID under wifi/, where the
entry name is the SSID and the body is that network's iwd config as YAML (a
`psk:` line, or the WPA-EAP fields). bin/build-image runs this on the host and
injects the result into the postinst Ansible run, which bakes the iwd configs in
the chroot. Run it directly to inspect what would be injected.
"""
import glob
import json
import os
import subprocess
import sys

import yaml

store = os.path.expanduser(
    os.environ.get("PASSWORD_STORE_DIR") or "~/.local/share/password-store"
)

networks = []
for path in sorted(glob.glob(os.path.join(store, "wifi", "*.gpg"))):
    ssid = os.path.basename(path)[:-4]
    body = subprocess.run(
        ["pass", "show", f"wifi/{ssid}"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    networks.append({"ssid": ssid, **(yaml.safe_load(body) or {})})

json.dump(networks, sys.stdout)
