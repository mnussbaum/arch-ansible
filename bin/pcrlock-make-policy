#!/bin/bash
# Build (or refresh) the systemd-pcrlock policy for PCR 7. The one place its
# arguments live: systemd-pcrlock-make-policy.service runs this at boot (with
# --boot), and bin/pcrlock-secureboot-change runs it around a planned Secure
# Boot change.
#
#   --pcr=7         exactly PCR 7. PCR 11 is covered, better, by the signed
#                   policy (it survives A/B updates untouched); PCRs 0-5 move on
#                   every firmware or boot loader update.
#   --strict=yes    fail rather than quietly drop PCR 7 from the policy when the
#                   event log cannot be fully accounted for (systemd 262).
#   --recovery-pin  see below.
#
# The recovery PIN. pcrlock protects its TPM NV index with a PIN that it seals
# to the CURRENT policy. So once PCR 7 moves unexpectedly (a firmware or
# Secure Boot change nobody prepared for), the sealed PIN is unreachable, the
# policy can never be rewritten, and every later boot needs the LUKS recovery
# key. Measured in a VM: exactly that. So we choose the PIN ourselves
# (--recovery-pin=query, fed via $PIN) and keep it on the encrypted root,
# readable by root only. It is therefore available precisely when root has
# been unlocked, which after such a change means by the recovery key, and that
# boot re-predicts from the new state and heals the policy in place. The next
# boot unlocks from the TPM again. Anyone who can read it already has root.
#
# The PIN is fixed when the NV index is first allocated. A policy made before
# this existed (pcrlock's default, a hidden random PIN) will not accept it;
# `systemd-pcrlock remove-policy` and re-enrolling the volumes resets that.
set -o errexit
set -o nounset
set -o pipefail

pin_file=/var/lib/arch-ansible/pcrlock-recovery-pin
prior=/var/lib/pcrlock.d/240-secureboot-policy.pcrlock.d/prior.pcrlock

if [[ "${1:-}" == --boot ]]; then
    # bin/pcrlock-secureboot-change leaves the pre-change Secure Boot variables
    # behind as a second variant, so the policy covers both until the reboot
    # that applies the change. By now that boot has happened; keeping it would
    # let the policy keep accepting the old (for dbx: pre-revocation) state.
    rm -f "$prior"
fi

if [[ ! -s "$pin_file" ]]; then
    (umask 077 && mkdir -p "${pin_file%/*}" \
        && head -c 32 /dev/urandom | base64 -w0 > "$pin_file")
fi

# The initrd cannot read /var, so make-policy also writes the policy to the ESP
# as a pcrlock.<entry-token>.cred credential, which is what unlocks root at
# boot. Three ways that copy went stale in a VM, each fixed here:
#   * the entry token resolved to the machine-id at boot but to "image" from a
#     shell, leaving two copies — and the initrd uses the FIRST one whose NV
#     index matches, stale or not. Pin it, and delete any other copy;
#   * make-policy skips everything, including the ESP copy, when the prediction
#     is unchanged — so a copy missed once is never rewritten. Force it when
#     ours is missing or older than the policy;
#   * at boot the ESP was not mounted yet ("Did not find XBOOTLDR/ESP
#     partition"); the unit now orders after boot.automount.
policy=/var/lib/systemd/pcrlock.json
esp=$(bootctl --print-esp-path 2>/dev/null) || esp=
token=$(</etc/machine-id)
force=()
if [[ -n "$esp" ]]; then
    cred="$esp/loader/credentials/pcrlock.$token.cred"
    if [[ ! -s "$cred" || "$cred" -ot "$policy" ]]; then
        force=(--force)
    fi
fi

PIN=$(<"$pin_file") /usr/lib/systemd/systemd-pcrlock make-policy \
    --location=770 --pcr=7 --strict=yes --recovery-pin=query \
    --entry-token=machine-id "${force[@]}"

if [[ -n "$esp" && -s "$cred" ]]; then
    find "$esp/loader/credentials" -maxdepth 1 -iname 'pcrlock.*.cred' \
        ! -name "pcrlock.$token.cred" -print -delete
fi
