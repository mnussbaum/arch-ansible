#!/usr/bin/env bash
# Runs this project's VMs; see `bin/vm --help`. The harness lives in
# src/arch_ansible_vm and needs only the standard library.

set -o errexit
set -o nounset
set -o pipefail

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m arch_ansible_vm "$@"
