#!/bin/bash
# Extends GPG subkey expiry by a year and exports the renewed public key.
# YubiKeys don't store expiry, so they need no reprogramming afterwards.
#
# Usage: bin/renew-gpg-subkeys <device>
#
# <device>: encrypted USB block device containing primary-key.asc (e.g. /dev/sdb)
#
# Run annually with the offline USB plugged in. The primary key is imported into
# a temporary GNUPGHOME so the main keyring is never touched. Afterwards
# ansible/roles/gpg/files/gpg-pubkey.asc holds the new expiry and should be
# committed.

set -o errexit
set -o nounset
set -o pipefail

source bin/_gpg_common.sh

DEVICE="${1:?Usage: $0 <device>}"

RENEWAL_HOME=$(mktemp -d)

cleanup() {
  close_usb
  rm -rf "$RENEWAL_HOME"
}
trap cleanup EXIT

setup_gnupghome "$RENEWAL_HOME"
export GNUPGHOME="$RENEWAL_HOME"

open_usb "$DEVICE"

echo "==> Importing primary key from USB..."
"${GPG_BATCH[@]}" --import "$USB_MOUNT/primary-key.asc"

FINGERPRINT=$(gpg --list-keys --with-colons | awk -F: '/^fpr/ { print $10; exit }')
echo "==> Fingerprint: $FINGERPRINT"

echo "==> Extending all subkey expiry by 1 year..."
"${GPG_BATCH[@]}" --yes --quick-set-expire "$FINGERPRINT" 1y "*"

echo "==> Exporting updated public key to ansible/roles/gpg/files/gpg-pubkey.asc..."
gpg --armor --export "$FINGERPRINT" > ansible/roles/gpg/files/gpg-pubkey.asc

echo ""
echo "Commit the renewed public key:"
echo "  git add ansible/roles/gpg/files/gpg-pubkey.asc && git commit -m 'Renew GPG subkeys'"
