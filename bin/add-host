#!/bin/bash
set -euo pipefail

REPO=$(cd "$(dirname "$0")/.." && pwd)

usage() {
    echo "Usage: add-host <hostname>" >&2
    exit 1
}

[[ $# -eq 1 ]] || usage
HOSTNAME=$1

HOST_VARS="$REPO/host_vars/$HOSTNAME.yml"
MKOSI_DIR="$REPO/mkosi.images/$HOSTNAME"
REPART_DIR="$MKOSI_DIR/mkosi.repart"
EXTRA_DIR="$MKOSI_DIR/mkosi.extra"

if [[ -e "$HOST_VARS" || -e "$MKOSI_DIR" ]]; then
    echo "add-host: $HOSTNAME already exists" >&2
    exit 1
fi

UUID=$(uuidgen)
echo "Partition UUID: $UUID"

# host_vars
cat >"$HOST_VARS" <<EOF
---
disk:
  device: /dev/nvme0n1
  partition_uuid: $UUID

networking:
  interface: wlan0
  networks: []
EOF

# mkosi image directory
mkdir -p "$REPART_DIR" "$EXTRA_DIR/etc"

cat >"$MKOSI_DIR/mkosi.conf" <<EOF
[Include]
Include=../../mkosi.common

[Output]
Format=disk
ImageId=$HOSTNAME

[Content]
BuildScripts=../../mkosi.build
KernelCommandLine=root=/dev/mapper/cryptroot rw quiet
EOF

cat >"$REPART_DIR/10-root.conf" <<EOF
[Partition]
Type=root
Format=ext4
Encrypt=key-file
UUID=$UUID
EOF

printf 'cryptroot PARTUUID=%s - luks\n' "$UUID" \
    >"$EXTRA_DIR/etc/crypttab.initramfs"

# Add to hosts.yml
if ! grep -q "^    $HOSTNAME:" "$REPO/hosts.yml"; then
    sed -i "s/^    usi:$/    usi:\n    $HOSTNAME:\n      ansible_connection: local/" \
        "$REPO/hosts.yml"
fi

echo "Created $HOSTNAME with partition UUID $UUID"
echo "Edit host_vars/$HOSTNAME.yml to set networking, monitors, and other host-specific vars"
echo "Edit mkosi.images/$HOSTNAME/mkosi.conf to set KernelCommandLine for the target hardware"
