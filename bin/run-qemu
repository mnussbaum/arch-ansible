#!/bin/bash

set -o errexit
set -o nounset

source bin/_qemu_common.sh

# --usi:    boot the USI alone
# --repair: boot the USI with the persistent qemu disk as a second drive,
#           emulating a live USB plugged into the target machine
case "${1:-}" in
  --usi|--repair)
    mode="$1"
    shift
    ;;
  *)
    mode=""
    ;;
esac
extra_mkosi_args=("$@")

case "$mode" in
  --usi)
    image_dir=mkosi.images/usi
    cpus=4
    ram=6G
    extra_vmm_args=()
    ;;
  --repair)
    image_dir=mkosi.images/usi
    cpus=4
    ram=6G
    extra_vmm_args=(
      "-drive" "if=none,id=hd1,file=$qemu_output_dir/arch.raw,format=raw"
      "-device" "scsi-hd,bus=scsi0.0,drive=hd1"
    )
    ;;
  "")
    image_dir=mkosi.images/qemu
    cpus=4
    ram=4G
    extra_vmm_args=(
      "-chardev" "socket,path=/tmp/qemu-guest-agent.sock,server=on,wait=off,id=qga0"
      "-device" "virtio-serial"
      "-device" "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"
    )
    ;;
esac

mkosi \
  --directory="$image_dir" \
  --output-directory="$qemu_output_dir" \
  --cpus="$cpus" \
  --ram="$ram" \
  --vsock=yes \
  --vsock-cid=3 \
  --runtime-tree="$PWD/$qemu_shared_dir:/run/host/shared" \
  "${extra_mkosi_args[@]}" \
  vm -- "${extra_vmm_args[@]}"
