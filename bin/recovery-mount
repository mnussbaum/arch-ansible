#!/bin/bash
# Mount a persistent install's partitions under /mnt the way the running system
# arranges them — decrypted root at /mnt (with its nested /var subvolume), the
# read-only erofs /usr over it, the ESP at /mnt/efi, and the home partition at
# /mnt/home — then arch-chroot in.
#
# Layout (systemd-repart, discoverable partitions): a LUKS2 root (GPT label
# "root", TPM2-enrolled) holding a btrfs with a nested /var subvolume; a separate
# read-only erofs /usr (dm-verity in a normal boot — mounted plain ro here, since
# recovery doesn't need integrity enforcement); a vfat ESP; an encrypted swap;
# and a btrfs home partition. systemd-homed keeps each user's data in its own
# LUKS volume *inside* /home, so individual users' files still need
# `homectl`/login to decrypt — this mounts the home partition, not the per-user
# homes. Swap is not a filesystem, so it is left alone.
#
# Usage: recovery-mount [DISK]
#   DISK  the disk to recover (e.g. /dev/vdb). Only needed when more than one
#         candidate root is found; normally it is discovered.
set -euo pipefail

TARGET=/mnt
want_disk=${1:+$(basename "$1")}

die() { echo "recovery-mount: $*" >&2; exit 1; }

# --- Which disk is the running system on? ------------------------------------
# The medium is a full mkosi layout too. Under the Live System profile it has no
# root partition (repart is masked), but once it has booted its default profile
# it has self-provisioned one — also labelled "root". Taking the first "root" in
# lsblk order then picks the MEDIUM (vda sorts before vdb), so rule out every
# disk backing the running /usr and ESP, walking dm-verity/crypt down to disks.
boot_disks=" "
for mnt in /usr /boot /efi; do
    src=$(findmnt -no SOURCE "$mnt" 2>/dev/null) || continue
    [[ $src == /dev/* ]] || continue
    while IFS= read -r line; do
        eval "$line"
        # One disk is reached via several paths (both verity partitions, the ESP).
        [[ ${TYPE:-} == disk && $boot_disks != *" $NAME "* ]] && boot_disks+="$NAME "
    done < <(lsblk -sPno NAME,TYPE "$src" 2>/dev/null)
done

# --- Find the root LUKS partition -------------------------------------------
# Match the GPT partition label "root": swap is also crypto_LUKS, so matching on
# type alone could grab the swap partition instead.
candidates=()
while IFS= read -r line; do
    eval "$line"
    [[ "${PARTLABEL:-}" == "root" && "${FSTYPE:-}" == "crypto_LUKS" ]] || continue
    disk=$(lsblk -no PKNAME "/dev/$NAME" | head -1)
    [[ $boot_disks == *" $disk "* ]] && continue          # the running system's own
    [[ -n $want_disk && $disk != "$want_disk" ]] && continue
    candidates+=("/dev/$NAME")
done < <(lsblk -Pno NAME,FSTYPE,PARTLABEL)

case ${#candidates[@]} in
    0) die "no LUKS 'root' partition found${want_disk:+ on /dev/$want_disk}" \
           "(the running system's own disk(s):${boot_disks% } are excluded)" ;;
    1) root_luks=${candidates[0]} ;;
    *) die "several candidate roots: ${candidates[*]} — pass the disk to" \
           "recover, e.g. recovery-mount /dev/$(lsblk -no PKNAME "${candidates[0]}" | head -1)" ;;
esac

# Scope every other partition to the root's parent disk, so we never pick up the
# recovery medium's own ESP/usr (its /usr carries the same label as the target's).
parent=$(lsblk -no PKNAME "$root_luks" | head -1)
[[ -n "$parent" ]] || die "could not determine the parent disk of $root_luks"
echo "Persistent disk: /dev/$parent (root: $root_luks)"

# --- Find the other partitions on that disk ---------------------------------
esp="" usr="" home=""
while IFS= read -r line; do
    eval "$line"
    dev="/dev/$NAME"
    case "${FSTYPE:-}" in
        # Only the home btrfs is a raw partition; the root btrfs is inside LUKS.
        btrfs) home="$dev" ;;
        # Active /usr slot; the inactive A/B slot is empty (no filesystem). If
        # both are populated (post-update) the first is fine — either is a valid /usr.
        erofs) usr="${usr:-$dev}" ;;
        vfat)  esp="$dev" ;;
    esac
done < <(lsblk -Pno NAME,FSTYPE,PARTLABEL "/dev/$parent")
[[ -n "$usr" ]] || die "no erofs /usr partition found on /dev/$parent"
[[ -n "$esp" ]] || echo "recovery-mount: warning: no ESP found on /dev/$parent" >&2

# --- Unlock root ------------------------------------------------------------
# The TPM2 token binds PCR 7 AND a signed PCR 11 policy (tpm2_pubkey_pcrs=[11];
# PCR 7 is literal from repart at first, then a pcrlock policy once
# pcrlock-enroll-luks.service has run), and both must be satisfied. PCR 11
# measures THIS UKI and its boot phases, so a recovery boot — a different UKI,
# and the Live profile signs no expected PCRs at all — can never match it, no
# matter that PCR 7 does. The token therefore cannot unlock from here. (On the
# volume's OWN boot it can, which is how luks-enroll-pkcs11.service authorizes
# enrollment; that is not this case.) Tokens are still tried first, because the
# YubiKey's PKCS#11 (PIV) token has no such limit.
#
# Anything a human can type is a keyslot NOT bound to a hardware token (a
# passphrase, or a systemd-cryptenroll --recovery-key slot). If there is none,
# prompting would just loop forever, so say so instead.
typeable_slots() {
    cryptsetup luksDump --dump-json-metadata "$1" 2>/dev/null | python3 -c '
import json, sys
m = json.load(sys.stdin)
hw = {"systemd-tpm2", "systemd-fido2", "systemd-pkcs11"}
bound = {s for t in m["tokens"].values() if t.get("type") in hw for s in t.get("keyslots", [])}
print(len([k for k in m["keyslots"] if k not in bound]))'
}

if cryptsetup status cryptroot &>/dev/null; then
    echo "cryptroot already open"
# Not `cryptsetup open --token-only`: Arch's libcryptsetup has no token plugins,
# so only systemd-cryptsetup's own PKCS#11 path can use the YubiKey slot. No
# TPM2 attempt: as above, it can't match here, and only fails noisily.
elif echo "Unlocking root: enter the YubiKey PIV PIN, then touch it." &&
     /usr/lib/systemd/systemd-cryptsetup attach cryptroot "$root_luks" - \
        pkcs11-uri=auto; then
    echo "Opened root with the YubiKey (PIV)"
elif [[ $(typeable_slots "$root_luks") -gt 0 ]]; then
    echo "No token unlocked it (a signed-PCR-11 TPM2 token cannot, from a booted"
    echo "system); enter the recovery key or passphrase:"
    cryptsetup open "$root_luks" cryptroot
else
    die "$root_luks has no factor usable from recovery: its only keyslot(s) are" \
        "bound to hardware tokens that did not unlock, and there is no recovery" \
        "key or passphrase to type. A signed-PCR-11 TPM2 token only unlocks in" \
        "the initrd of a normal signed boot. This root needs a recovery key or" \
        "YubiKey (PKCS#11) factor enrolled when it is created (see bootstrapping.md)."
fi

# --- Mount, mirroring the running system's layout ---------------------------
btrfs_opts="noatime,compress=zstd:1,discard=async,space_cache=v2"
mount -o "$btrfs_opts" /dev/mapper/cryptroot "$TARGET"   # root (+ nested /var subvolume)
mount -o ro "$usr" "$TARGET/usr"                          # immutable /usr (erofs)
if [[ -n "$esp" ]]; then
    mkdir -p "$TARGET/efi"
    mount "$esp" "$TARGET/efi"
fi
[[ -n "$home" ]] && mount -o "$btrfs_opts" "$home" "$TARGET/home"  # home partition (per-user homed LUKS lives here)

echo "Mounted under $TARGET:"
findmnt -R "$TARGET" || true

exec arch-chroot "$TARGET"
