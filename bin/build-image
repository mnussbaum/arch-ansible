#!/bin/bash

set -o errexit
set -o nounset

refresh_cache=""
skip_postinst=""
ansible_tags=""
mkosi_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      echo "Build the image. run-image/burn-image set the hostname at boot." >&2
      echo "Usage: $0 [--refresh-cache] [--skip-postinst] [--ansible-tags TAGS] [mkosi options...]" >&2
      echo "  --refresh-cache  Bust the mkosi incremental package cache." >&2
      echo "  --skip-postinst  Skip the Ansible post-installation step." >&2
      echo "  --ansible-tags   Limit Ansible to specific tags." >&2
      echo "  Any other options are forwarded to mkosi." >&2
      exit
      ;;
    --refresh-cache) refresh_cache="--incremental=no" ;;
    --skip-postinst) skip_postinst="--environment=SKIP_POSTINST=1" ;;
    --ansible-tags) ansible_tags="--environment=ANSIBLE_TAGS=$2"; shift ;;
    *)
      mkosi_args+=("$1")
      if [[ "$1" =~ ^-- ]] && [[ $# -gt 1 && "$2" != -* ]]; then mkosi_args+=("$2"); shift; fi
      ;;
  esac
  shift
done

source bin/_secureboot_common.sh
materialize_secureboot_keypair

source bin/_credstore_common.sh

# base64 so the JSON survives the env-var trip through mkosi into the chroot
# unmangled (no quotes/spaces/colons); decoded in mkosi.postinst.chroot.
wifi_networks=$(bin/wifi-networks | base64 -w0)

output_dir=~/.cache/mkosi/images/image
mkdir -p ~/.cache/mkosi/pacman-pkg "$output_dir"

mkosi \
  --output-directory="$output_dir" \
  --tools-tree=/ \
  --secure-boot-certificate="$PWD/mkosi.crt" \
  --secure-boot-key="$PWD/mkosi.key" \
  --sign-expected-pcr-certificate="$PWD/mkosi.crt" \
  --sign-expected-pcr-key="$PWD/mkosi.key" \
  --verity-certificate="$PWD/mkosi.crt" \
  --verity-key="$PWD/mkosi.key" \
  --profile=build \
  --force \
  --environment="ANSIBLE_WIFI_NETWORKS=$wifi_networks" \
  ${refresh_cache:+"$refresh_cache"} \
  ${skip_postinst:+"$skip_postinst"} \
  ${ansible_tags:+"$ansible_tags"} \
  "${mkosi_args[@]}" \
  build

echo "Built image:" >&2
ls -1 "$output_dir"/*.raw 2>/dev/null >&2 || echo "  (output in $output_dir)" >&2
