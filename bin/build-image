#!/bin/bash

set -o errexit
set -o nounset
set -o pipefail

caching="available"
keep="3"
skip_postinst=""
ansible_tags=""
mkosi_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      echo "Build the image. vm live/burn-image set the hostname at boot." >&2
      echo "Usage: $0 [--caching force|off|available] [--keep N|all] [--skip-postinst] [--ansible-tags TAGS] [mkosi options...]" >&2
      echo "  --caching        Package cache policy for the package-install AND postinst" >&2
      echo "                   phases (default: available):" >&2
      echo "                     force      install only already-cached packages; never use the network" >&2
      echo "                     off        ignore the cache; refresh metadata and pull everything fresh" >&2
      echo "                     available  use the cache where it satisfies the request, download the rest" >&2
      echo "  --keep           After a successful build, prune the output directory to the" >&2
      echo "                   newest N image versions (default: 3). 'all' keeps every" >&2
      echo "                   version; each one costs ~18G." >&2
      echo "  --skip-postinst  Skip the Ansible post-installation step." >&2
      echo "  --ansible-tags   Limit Ansible to specific tags." >&2
      echo "  Any other options are forwarded to mkosi." >&2
      exit
      ;;
    --caching=*) caching="${1#*=}" ;;
    --caching) caching="$2"; shift ;;
    --keep=*) keep="${1#*=}" ;;
    --keep) keep="$2"; shift ;;
    --skip-postinst) skip_postinst="--environment=SKIP_POSTINST=1" ;;
    --ansible-tags=*) ansible_tags="--environment=ANSIBLE_TAGS=${1#*=}" ;;
    --ansible-tags) ansible_tags="--environment=ANSIBLE_TAGS=$2"; shift ;;
    *)
      mkosi_args+=("$1")
      if [[ "$1" =~ ^-- ]] && [[ $# -gt 1 && "$2" != -* ]]; then mkosi_args+=("$2"); shift; fi
      ;;
  esac
  shift
done

# Map --caching to mkosi's package-manager network policy for the package-install
# phase. The same mode rides into the postinst chroot via CACHING (below) so its
# pacman/yay follow suit — see mkosi.postinst.chroot and the pacman.conf template.
#   force     cache-only, never touch the network (CacheOnly=always).
#   off       always resync metadata and download; also bust the incremental
#             image cache so the install actually re-runs (CacheOnly=never).
#   available resync metadata so requested versions match the mirror, then reuse
#             the cache for any package already present at that version and
#             download the rest (CacheOnly=auto). Not 'metadata': skipping the
#             resync makes pacman request the seeded DB's versions, which 404
#             once the mirror purges them as that DB drifts behind upstream.
caching_args=()
case "$caching" in
  force)     caching_args=(--cache-only=always) ;;
  off)       caching_args=(--cache-only=never --incremental=no) ;;
  available) caching_args=(--cache-only=auto) ;;
  *)
    echo "error: --caching must be one of: force, off, available (got '$caching')" >&2
    exit 1
    ;;
esac

if [[ "$keep" != all && ! "$keep" =~ ^[1-9][0-9]*$ ]]; then
  echo "error: --keep must be a positive integer or 'all' (got '$keep')" >&2
  exit 1
fi

source bin/_cache_common.sh
arch_ansible_ensure_cache
arch_ansible_stage_srctree

# Point pass at the shipped password-store when building from a live/volatile
# medium. The live-USB profile boots a fresh tmpfs $HOME with no password-store,
# but the encrypted store ships read-only in the image at /usr/share/password-store
# (ExtraTree), and a YubiKey supplies the GPG secret to decrypt it. Without this,
# the signing-key lookup falls back to $HOME/.local/share/password-store (empty)
# and the build aborts. A normal host build keeps its own ~/.local/share copy, so
# only the live case falls through here; an explicit PASSWORD_STORE_DIR wins.
if [[ -z "${PASSWORD_STORE_DIR:-}" \
      && ! -d "$HOME/.local/share/password-store" \
      && -d /usr/share/password-store ]]; then
  export PASSWORD_STORE_DIR=/usr/share/password-store
fi

source bin/_secureboot_common.sh
materialize_secureboot_keypair

source bin/_credstore_common.sh

# base64 so the JSON survives the env-var trip through mkosi into the chroot
# unmangled (no quotes/spaces/colons); decoded in mkosi.postinst.chroot.
wifi_networks=$(bin/wifi-networks | base64 -w0)

output_dir="$ARCH_ANSIBLE_OUTPUT_DIR"
# Local reusable caches: created empty on first build, then primed and reused
# across builds. This keeps the build fast/offline with no system caches to draw
# on (e.g. an image-based device). yay/cargo/sccache back their build steps.
# pacman-pkg/cache/pacman/pkg is mkosi's own PackageCacheDirectory layout; the
# .chroot postinst reads it as a BuildSource (mkosi.conf), which fails if the
# path is absent on a cold cache, so create the nested dir up front. Paths track
# ${ARCH_ANSIBLE_CACHE} (bin/_cache_common.sh).
mkdir -p "$ARCH_ANSIBLE_CACHE/mkosi/pacman-pkg/cache/pacman/pkg" "$output_dir" \
  "$ARCH_ANSIBLE_CACHE/yay" \
  "$ARCH_ANSIBLE_CACHE/aur-repo" \
  "$ARCH_ANSIBLE_CACHE/nvim/site" \
  "$ARCH_ANSIBLE_CACHE/cargo/registry" "$ARCH_ANSIBLE_CACHE/sccache"

# Prime an empty nvim plugin/parser cache from the invoking user's personal nvim,
# so the very first build (or one after a cache wipe) skips re-fetching ~130M of
# plugins and recompiling tree-sitter parsers. Only when the cache is empty —
# once it self-primes via mkosi.finalize writebacks we leave it alone, so the
# image's plugin set tracks plugins.lua rather than drifting toward the host's.
if [[ -z "$(ls -A "$ARCH_ANSIBLE_CACHE/nvim/site" 2>/dev/null)" \
      && -d "$HOME/.local/share/nvim/site" ]]; then
  rsync -a "$HOME/.local/share/nvim/site/" "$ARCH_ANSIBLE_CACHE/nvim/site/"
fi

# Bootstrap the yay package on a cold cache. mkosi.build installs yay from the
# local AUR repo (yay-bin-*.pkg.tar.zst) before the postinst runs — but that
# package is normally produced BY the postinst (setup-aur.yml force-builds it),
# a chicken-and-egg a fresh clone can't satisfy. Break it here: on the host, when
# the repo has no yay-bin, clone it from the AUR and makepkg it into the repo
# cache once (online). Subsequent builds reuse it; the postinst then keeps it
# fresh and bakes it into /usr for offline device rebuilds — which is why this is
# host-only (a device is offline and gets yay-bin from that /usr carry-forward).
# makepkg runs as the invoking user; PKGDEST/PKGEXT match setup-aur.yml so the
# filename is exactly what mkosi.build globs.
if [[ "${ARCH_ANSIBLE_TARGET:-host}" != device ]] \
   && ! compgen -G "$ARCH_ANSIBLE_CACHE/aur-repo/yay-bin-[0-9]*.pkg.tar.zst" > /dev/null; then
  echo "Cold cache: building the yay bootstrap package…" >&2
  yay_clone="$ARCH_ANSIBLE_CACHE/yay/yay-bin"
  [[ -d "$yay_clone/.git" ]] \
    || git clone --depth=1 https://aur.archlinux.org/yay-bin.git "$yay_clone"
  ( cd "$yay_clone" \
    && PKGDEST="$ARCH_ANSIBLE_CACHE/aur-repo" PKGEXT='.pkg.tar.zst' \
       makepkg --force --noconfirm --nodeps --skippgpcheck )
fi

# Fresh, monotonic image version so each build supersedes the running slot for
# systemd-sysupdate. mkosi reads mkosi.version for ImageVersion (unset in
# mkosi.conf); partitions and the UKI are labeled image_<version>_<arch>.
./mkosi.bump > mkosi.version

mkosi \
  --output-directory="$output_dir" \
  --tools-tree=/ \
  --secure-boot-certificate="$SECUREBOOT_CERT" \
  --secure-boot-key="$SECUREBOOT_KEY" \
  --sign-expected-pcr-certificate="$SECUREBOOT_CERT" \
  --sign-expected-pcr-key="$SECUREBOOT_KEY" \
  --verity-certificate="$SECUREBOOT_CERT" \
  --verity-key="$SECUREBOOT_KEY" \
  --profile=build \
  --force \
  --environment="ANSIBLE_WIFI_NETWORKS=$wifi_networks" \
  --environment="ARCH_ANSIBLE_TARGET=${ARCH_ANSIBLE_TARGET:-host}" \
  `# TRANSITIONAL: selects mkosi.conf.d/10-sources-*.conf; remove after cutover` \
  "${caching_args[@]}" \
  --environment="CACHING=$caching" \
  ${skip_postinst:+"$skip_postinst"} \
  ${ansible_tags:+"$ansible_tags"} \
  "${mkosi_args[@]}" \
  build

# Fold the postinst-generated yay/cargo/sccache caches into the reusable caches
# so the next build's SkeletonTrees/BuildSources seed them. mkosi.finalize can't
# write the host ~/.cache from its sandbox, so it stages the new files into the
# output dir; here (on the host, post-mkosi) we merge them and clear the staging.
# (pacman is handled inside mkosi.finalize via the package-cache mount.)
cwb="$output_dir/cache-writeback"
if [[ -d "$cwb" ]]; then
  [[ -d "$cwb/yay" ]]            && rsync -a "$cwb/yay/"            "$ARCH_ANSIBLE_CACHE/yay/"
  [[ -d "$cwb/aur-repo" ]]       && rsync -a "$cwb/aur-repo/"       "$ARCH_ANSIBLE_CACHE/aur-repo/"
  [[ -d "$cwb/nvim-site" ]]      && rsync -a "$cwb/nvim-site/"      "$ARCH_ANSIBLE_CACHE/nvim/site/"
  [[ -d "$cwb/cargo-registry" ]] && rsync -a "$cwb/cargo-registry/" "$ARCH_ANSIBLE_CACHE/cargo/registry/"
  [[ -d "$cwb/sccache" ]]        && rsync -a "$cwb/sccache/"        "$ARCH_ANSIBLE_CACHE/sccache/"
  rm -rf "$cwb"
fi

# Retention. Nothing here ever removed an old build, so the output directory grew
# without bound: it reached 353G across 23 versions, filled the disk, and failed a
# build with ENOSPC while repart was pre-populating the erofs. One version is the
# medium plus the split usr/verity/verity-sig/UKI artifacts — ~18G — so a handful
# is all that fits. Old versions are not reproducible (their Arch package sets have
# moved on), hence a conservative default of 3 and a --keep all escape hatch.
#
# Versions are the zero-padded UTC timestamps ./mkosi.bump emits, so a reverse
# sort is newest-first. Each version is deleted by its own explicit -name pattern:
# never an `rm` against a glob built from a variable. An empty variable in exactly
# that shape once expanded to `rm -f -- *` and took out every build in this
# directory, including the ones it was told to keep.
if [[ "$keep" != all ]]; then
  current=$(cat mkosi.version)
  kept=0
  while read -r version; do
    # Ignores the unversioned leftovers mkosi drops alongside (initrd*, tpm/).
    [[ "$version" =~ ^[0-9]+$ ]] || continue
    kept=$((kept + 1))
    (( kept > keep )) || continue
    # Belt and braces: the build we just made is the newest, so it is already
    # inside the keep window — but never let it fall out of one.
    [[ "$version" != "$current" ]] || continue
    echo "Pruning image version $version" >&2
    find "$output_dir" -maxdepth 1 -name "image_${version}_*" -delete
  done < <(
    find "$output_dir" -maxdepth 1 -name 'image_*' -printf '%f\n' \
      | sed -n 's/^image_\([0-9]\{1,\}\)_.*/\1/p' \
      | sort -rnu
  )
fi

echo "Built image:" >&2
ls -1 "$output_dir"/*.raw 2>/dev/null >&2 || echo "  (output in $output_dir)" >&2
