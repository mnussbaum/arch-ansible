#!/usr/bin/env bash
# Build the image on someone else's Linux or macOS machine, in a container, for
# disaster recovery; then write it to a USB stick with bin/dr-burn. Needs only
# podman or docker (plus gnupg on macOS). See docs/disaster-recovery.md.
#
# bash 3.2 and BSD tools: this runs on stock macOS.
set -o errexit
set -o nounset
set -o pipefail

image=arch-ansible-dr
volume=arch-ansible-dr-cache

usage() {
  echo "Build the image in a container, on Linux or macOS. Write it with bin/dr-burn." >&2
  echo "Usage: $0 [--ephemeral-key] [--password-store DIR | --password-store-url URL]" >&2
  echo "          [--out DIR] [-- build-image options...]" >&2
  echo "  --ephemeral-key       No YubiKey: sign with a throwaway key and ask for a new" >&2
  echo "                        home password. Boot it with Secure Boot in setup mode." >&2
  echo "  --password-store      Use this password-store instead of cloning it." >&2
  echo "  --password-store-url  Clone it from here (default: GitLab over SSH via the YubiKey;" >&2
  echo "                        with --ephemeral-key, no password-store unless given)." >&2
  echo "  --out                 Where the medium lands (default: dr-out/ in the checkout)." >&2
  echo "  Builds the committed state of this checkout. Caches persist in the" >&2
  echo "  '$volume' volume; remove it to reclaim the space." >&2
}

ephemeral=
store_dir=
store_url=
out=
build_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --ephemeral-key) ephemeral=1 ;;
    --password-store) store_dir=$2; shift ;;
    --password-store-url) store_url=$2; shift ;;
    --out) out=$2; shift ;;
    -h|--help) usage; exit ;;
    --) shift; build_args=("$@"); break ;;
    *) echo "dr-build: unexpected argument: $1" >&2; usage; exit 1 ;;
  esac
  shift
done

die() { echo "dr-build: $*" >&2; exit 1; }

cd "$(dirname "$0")/.."
repo=$PWD
: "${out:=$repo/dr-out}"
mkdir -p "$out"
out=$(cd "$out" && pwd)
if [ -n "$store_dir" ]; then store_dir=$(cd "$store_dir" && pwd); fi
os=$(uname -s)

# The container runtime. Rootful: mkosi and the YubiKey need a real --privileged.
if command -v podman >/dev/null; then
  rt=(podman)
  if [ "$os" = Darwin ]; then
    rootful=$(podman machine inspect --format '{{.Rootful}}' 2>/dev/null | head -1) \
      || die "no podman machine; see docs/disaster-recovery.md"
    [ "$rootful" = true ] \
      || die "the podman machine must be rootful: podman machine stop; podman machine set --rootful; podman machine start"
  elif [ "$(id -u)" -ne 0 ]; then
    rt=(sudo podman)
  fi
elif command -v docker >/dev/null; then
  rt=(docker)
  if [ "$os" = Linux ] && ! docker info >/dev/null 2>&1; then rt=(sudo docker); fi
else
  die "install podman or docker first; see docs/disaster-recovery.md"
fi
"${rt[@]}" info >/dev/null 2>&1 || die "'${rt[*]} info' fails; is the runtime (or its VM) running?"

if [ "${rt[0]}" = docker ] || [ "${rt[1]:-}" = docker ]; then
  mem=$("${rt[@]}" info --format '{{.MemTotal}}')
else
  mem=$("${rt[@]}" info --format '{{.Host.MemTotal}}')
fi
if [ "${mem:-0}" -lt 8000000000 ]; then
  echo "dr-build: warning: the runtime has $((mem / 1000000000))G of memory; give it 8G+" >&2
fi

run=("${rt[@]}" run --rm --interactive --tty --privileged --platform linux/amd64
  --shm-size 2g
  --volume "$repo:/host-repo:ro"
  --volume "$volume:/home/builder/.cache"
  --volume "$out:/out")
if [ -n "$store_dir" ]; then run+=(--volume "$store_dir:/host-password-store:ro"); fi
if [ -n "$store_url" ]; then run+=(--env "DR_PASSWORD_STORE_URL=$store_url"); fi

secrets=
cleanup() {
  if [ -n "$secrets" ]; then rm -rf "$secrets"; fi
}
trap cleanup EXIT

if [ -n "$ephemeral" ]; then
  run+=(--env DR_MODE=ephemeral)
elif [ "$os" = Linux ]; then
  # The container runs its own pcscd, which can't share the reader with the host's.
  if pgrep -x pcscd >/dev/null; then
    die "pcscd is running here and holds the YubiKey; stop it first: sudo systemctl stop pcscd.socket pcscd.service"
  fi
  run+=(--env DR_MODE=yubikey)
else
  # Containers on macOS can't reach USB, so decrypt here. Under $HOME, which
  # every macOS runtime shares into its VM; deleted on exit.
  secrets=$(mktemp -d "$HOME/.dr-secrets.XXXXXX")
  unlock_args=(--repo "$repo" --out "$secrets")
  if [ -n "$store_dir" ]; then unlock_args+=(--password-store "$store_dir"); fi
  if [ -n "$store_url" ]; then unlock_args+=(--password-store-url "$store_url"); fi
  container/dr-unlock "${unlock_args[@]}"
  run+=(--env DR_MODE=provided --volume "$secrets:/host-secrets:ro")
fi

echo "==> Building the builder container" >&2
"${rt[@]}" build --platform linux/amd64 --tag "$image" --file container/Containerfile .

echo "==> Building the image (a cold build takes hours, more under emulation)" >&2
"${run[@]}" "$image" ${build_args[@]+"${build_args[@]}"}

echo "Built:" >&2
ls -1t "$out"/image_*.raw | head -1 >&2
echo "Write it to a USB stick with: bin/dr-burn <image> <device>" >&2
