#!/bin/bash
# Enroll a YubiKey (FIDO2) as the root volume's recovery factor, on first boot.
#
# Why root needs one: the TPM2 token repart enrolls binds PCR 7 AND a signed PCR
# 11 policy. That is the right posture for automatic unlock, but it means the
# seal breaks whenever the measured boot legitimately changes — a firmware
# update, a Secure Boot key re-enrollment, a cleared TPM or a replaced board —
# and, because PCR 11 belongs to THIS UKI, nothing can unlock the volume from a
# recovery medium. Without a second factor such a root is simply gone, and
# bin/recovery-mount cannot open it.
#
# FIDO2 has neither limit: it unlocks wherever the key is present, including
# from a recovery boot.
#
# Authorization comes from the TPM2 token itself (--unlock-tpm2-device=auto),
# which works from the booted system because the UKI ships signed PCR 11 values
# for the later boot phases too. This is what AstrOS does to enroll its recovery
# key at first boot. No bootstrap keyslot is needed, so root is never briefly
# openable with an empty password.
#
# Failing to enroll is therefore not fatal and leaves nothing to clean up: the
# volume keeps its TPM2 token, and a key can be enrolled later from any normal
# boot with exactly the command printed below. Blocking the boot instead would
# strand a machine whose YubiKey is simply elsewhere.
set -o errexit
set -o nounset
set -o pipefail

dev=${1:-/dev/disk/by-designator/root-luks}
wait_secs=${ENROLL_FIDO2_WAIT:-120}

log() { echo "enroll-root-fido2: $*"; }

[[ -e "$dev" ]] || { log "no root LUKS device at $dev; nothing to do"; exit 0; }

# Idempotent: a FIDO2 token already enrolled means this ran before, or a human
# did it by hand.
if cryptsetup luksDump "$dev" | grep -q 'systemd-fido2'; then
    log "a FIDO2 token is already enrolled on $dev; nothing to do"
    exit 0
fi

# --fido2-device=list prints a table with a header; the rows are device paths,
# so match those rather than "any output" (there is no --no-legend here).
have_key() { systemd-cryptenroll --fido2-device=list 2>/dev/null | grep -q '^/dev/'; }

if ! have_key; then
    log "Insert the YubiKey to enroll as this machine's recovery factor."
    log "Waiting up to ${wait_secs}s (boot continues either way)…"
    for (( i = 0; i < wait_secs; i++ )); do
        have_key && break
        sleep 1
    done
fi

if have_key; then
    log "Enrolling FIDO2 token (touch the key when it blinks)…"
    if systemd-cryptenroll "$dev" --unlock-tpm2-device=auto --fido2-device=auto; then
        log "FIDO2 enrolled on $dev."
        exit 0
    fi
    log "WARNING: FIDO2 enrollment failed."
else
    log "WARNING: no YubiKey appeared within ${wait_secs}s."
fi

log "WARNING: $dev has only its TPM2 token, so it cannot be unlocked from a"
log "WARNING: recovery medium, and is unrecoverable if its measured boot"
log "WARNING: changes (firmware update, Secure Boot re-enrollment, cleared TPM,"
log "WARNING: replaced board). Enroll a key later from any normal boot with:"
log "WARNING:   systemd-cryptenroll $dev --unlock-tpm2-device=auto --fido2-device=auto"
log "WARNING: or a printed recovery key with --recovery-key instead."
