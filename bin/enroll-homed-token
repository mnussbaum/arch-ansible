#!/bin/bash
# Enroll the YubiKey PIV cert as the homed unlock factor for the current user
# and drop the password factor, so the greeter only asks for the YubiKey PIN
# (no multi-factor cycling).
#
# Must run as root (via sudo) - homectl's PIN ask uses systemd-ask-password,
# whose /run/systemd/ask-password/ is root-only, so a user-context homectl
# can't surface a prompt. Running as root puts the ask request where the
# ask-password agent picks it up and forwards to zenity in the user's sway
# session. A NOPASSWD sudoers rule for this exact script path keeps the
# privilege surface tight.
#
# You'll be prompted for:
#   - the PIV PIN (set during bin/enroll-yubikeys)
# Tap the YubiKey each time the LED blinks - touch-policy=cached only carries
# one op; homectl makes several so multiple taps are expected.
#
# After this the recovery secret no longer logs you in; only the YubiKey does.
# bin/enroll-yubikeys re-imports the same shared PIV key into any new card, so
# re-provisioning continues to unlock all enrolled homes - no per-machine
# re-enrollment needed. The shared key in pass is the recovery story; lose all
# cards and pass simultaneously and the home is gone.
set -o errexit
set -o nounset
set -o pipefail

user="${SUDO_USER:-$(whoami)}"

if homectl inspect "$user" --json=short 2>/dev/null | grep -q pkcs11TokenUri; then
  echo "PIV already enrolled for $user; nothing to do."
  exit 0
fi

uri=$(p11tool --list-all-certs 'pkcs11:' 2>/dev/null \
  | sed -n 's/.*URL: //p' \
  | grep type=cert | grep -v p11-kit-trust \
  | head -1 \
  | sed -E 's/;serial=[^;]*//; s/;token=[^;]*//; s/;id=[^;]*//; s/;object=[^;]*//; s/;type=[^;]*//')

if [[ -z "$uri" ]]; then
  echo "No PKCS#11 cert found. Insert your YubiKey and check 'p11tool --list-tokens'." >&2
  exit 1
fi

echo "Enrolling PIV for $user: $uri"
homectl update "$user" --pkcs11-token-uri="$uri"

echo "Dropping the password factor..."
homectl inspect "$user" --json=minimal \
  | python3 -c '
import sys, json
record = json.load(sys.stdin)
record.get("privileged", {}).pop("hashedPassword", None)
json.dump(record, sys.stdout)
' \
  | homectl update "$user" --identity=-
