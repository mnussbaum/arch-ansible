#!/usr/bin/env bash
# Rebuilds the primary GPG key from the printed recovery guide and writes it to
# a new LUKS-encrypted root GPG key USB. Program YubiKeys from that USB
# afterwards with bin/enroll-yubikeys. Runs on any Linux or macOS computer with
# the tools in docs/set-up-recovery-computer.md, or in a Live System.
#
# The guide's paperkey lines hold only the secret bytes; the public key comes
# from the repo, which has the current one. The key is rebuilt in a temporary
# GNUPGHOME, deleted on exit.
#
# Usage: bin/restore-primary-gpg-from-paper [--secrets <file>] [--totp <file>] <device>
#
# <device>:          USB drive to erase and write the new root GPG key USB to.
# --secrets <file>:  the guide's numbered private key lines; asked for if absent.
# --totp <file>:     the guide's otpauth:// URIs, one per line, saved to the USB
#                    for enroll-yubikeys; asked for if absent.

set -o errexit
set -o nounset
set -o pipefail

source bin/_gpg_common.sh

USAGE="Usage: $0 [--secrets <file>] [--totp <file>] <device>"
SECRETS_FILE=""
TOTP_FILE=""
DEVICE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --secrets) SECRETS_FILE="$2"; shift ;;
    --totp) TOTP_FILE="$2"; shift ;;
    -h|--help) echo "$USAGE" >&2; exit ;;
    *)
      if [[ -n "$DEVICE" ]]; then echo "$USAGE" >&2; exit 1; fi
      DEVICE="$1"
      ;;
  esac
  shift
done
if [[ -z "$DEVICE" ]]; then
  echo "$USAGE" >&2
  exit 1
fi

PUBKEY_FILE="ansible/roles/gpg/files/gpg-pubkey.asc"
# Under /tmp: macOS's $TMPDIR is long enough to overflow the agent's socket path.
RESTORE_HOME=$(mktemp -d /tmp/restore-gnupg.XXXXXX)
STAGE=$(key_usb_stage_dir)

cleanup() {
  GNUPGHOME="$RESTORE_HOME" gpgconf --kill all 2>/dev/null || true
  rm -rf "$RESTORE_HOME" "$STAGE"
}
trap cleanup EXIT

setup_gnupghome "$RESTORE_HOME"
export GNUPGHOME="$RESTORE_HOME"
mkdir "$STAGE/files"

"${GPG_BATCH[@]}" --quiet --import "$PUBKEY_FILE"
FINGERPRINT=$(gpg --list-keys --with-colons | awk -F: '/^fpr/ { print $10; exit }')
echo "==> Key: $FINGERPRINT"

if [[ -z "$SECRETS_FILE" ]]; then
  SECRETS_FILE="$RESTORE_HOME/secrets.txt"
  echo "Type the numbered lines from the guide's \"Private key\" section and nothing"
  echo "else, then press Ctrl-D on an empty line:"
  cat > "$SECRETS_FILE"
fi

# Each line ends in a checksum, so paperkey names the line with a typo.
gpg --no-armor --export "$FINGERPRINT" > "$RESTORE_HOME/pubring.gpg"
until paperkey --pubring "$RESTORE_HOME/pubring.gpg" --secrets "$SECRETS_FILE" \
    | "${GPG_BATCH[@]}" --import 2>/dev/null; do
  echo ""
  echo "Fix the line paperkey names in $SECRETS_FILE (e.g. nano $SECRETS_FILE),"
  read -r -p "then press Enter to try again: " _
done
echo "==> Rebuilt the private key and its subkeys."

renew_expiring_subkeys

if [[ -z "$TOTP_FILE" ]]; then
  TOTP_FILE="$RESTORE_HOME/totp.txt"
  echo ""
  echo "Type the otpauth:// lines from the guide's \"Critical TOTP accounts\" section,"
  echo "one per line, then press Ctrl-D on an empty line (Ctrl-D alone for none):"
  cat > "$TOTP_FILE"
fi
if [[ -s "$TOTP_FILE" ]]; then
  cp "$TOTP_FILE" "$STAGE/files/oath-accounts.txt"
fi

echo "==> Preparing the new root GPG key USB..."
"${GPG_BATCH[@]}" --armor --export-secret-keys "$FINGERPRINT" > "$STAGE/files/primary-key.asc"
printf 'y\n0\n\ny\n' | gpg --command-fd 0 --gen-revoke "$FINGERPRINT" \
  > "$STAGE/files/revocation-cert.asc"
write_key_usb "$DEVICE" "$STAGE"

echo ""
echo "Done. Program YubiKeys from the new USB with: bin/enroll-yubikeys $DEVICE"
echo "Then store the USB offline, away from the YubiKeys."
if [[ -n "$RENEWED" ]]; then
  echo "The subkeys were renewed: commit and push the new public key, which builds use:"
  echo "  git commit -m 'Renew GPG subkeys' $PUBKEY_FILE && git push"
fi
