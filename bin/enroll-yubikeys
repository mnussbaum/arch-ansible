#!/bin/bash
# Renews GPG subkey expiry, reprograms any number of YubiKeys, enrolls each as a
# LUKS FIDO2 keyslot on the root partition (if cryptroot is active), and loads a
# shared PIV key + cert into each so systemd-homed can unlock the user via
# PKCS#11. The PIV key/cert live in pass (encrypted to the GPG key), generated on
# first run, so GPG stays the only root of trust, one key serves the user on
# every machine, and new YubiKeys can be added by re-running.
#
# Usage: bin/enroll-yubikeys <device>
#
# <device>: encrypted USB block device containing primary-key.asc (e.g. /dev/sdb)
#
# Run annually with the offline USB plugged in. The primary key is imported into
# a temporary GNUPGHOME so the main keyring is never touched. After the
# ceremony, roles/gpg/files/gpg-pubkey.asc is updated with the new expiry and should
# be committed.

set -o errexit
set -o nounset
set -o pipefail

source bin/_gpg_common.sh

DEVICE="${1:?Usage: $0 <device>}"

RENEWAL_HOME=$(mktemp -d)
SUBKEY_BACKUP=$(mktemp)

cleanup() {
  close_usb
  rm -rf "$RENEWAL_HOME"
  rm -f "$SUBKEY_BACKUP"
}
trap cleanup EXIT

setup_gnupghome "$RENEWAL_HOME"
export GNUPGHOME="$RENEWAL_HOME"

open_usb "$DEVICE"

echo "==> Importing primary key from USB..."
"${GPG_BATCH[@]}" --import "$USB_MOUNT/primary-key.asc"

FINGERPRINT=$(gpg --list-keys --with-colons | awk -F: '/^fpr/ { print $10; exit }')
echo "==> Fingerprint: $FINGERPRINT"

echo "==> Extending all subkey expiry by 1 year..."
"${GPG_BATCH[@]}" --yes --quick-set-expire "$FINGERPRINT" 1y "*"

echo "==> Exporting updated public key to roles/gpg/files/gpg-pubkey.asc..."
gpg --armor --export "$FINGERPRINT" > roles/gpg/files/gpg-pubkey.asc

echo "==> Creating subkey backup..."
"${GPG_BATCH[@]}" --armor --export-secret-subkeys "$FINGERPRINT" > "$SUBKEY_BACKUP"

program_all_yubikeys

echo ""
echo "Commit the updated public key:"
echo "  git add roles/gpg/files/gpg-pubkey.asc && git commit -m 'Enrolled yubikeys'"
