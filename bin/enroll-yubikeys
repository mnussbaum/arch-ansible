#!/bin/bash
# Reprograms any number of YubiKeys from the primary GPG USB and loads a shared
# PIV key + cert (from pass, encrypted to the GPG key) into each so systemd-homed
# can unlock the user via PKCS#11. The key lives in pass and is re-imported on
# every run, so re-provisioning a YubiKey keeps unlocking every machine that
# enrolled it - no per-machine re-enrollment. The homed enrollment itself happens
# per-machine at first login (see ansible/roles/user/tasks/first-login.yml).
#
# Usage: bin/enroll-yubikeys <device>
#
# <device>: encrypted USB block device containing primary-key.asc (e.g. /dev/sdb)
#
# The primary key is imported into a temporary GNUPGHOME so the main keyring is
# never touched. Subkey expiry is renewed separately by bin/renew-gpg-subkeys.

set -o errexit
set -o nounset
set -o pipefail

source bin/_gpg_common.sh

DEVICE="${1:?Usage: $0 <device>}"

ENROLL_HOME=$(mktemp -d)
SUBKEY_BACKUP=$(mktemp)

cleanup() {
  close_usb
  rm -rf "$ENROLL_HOME"
  rm -f "$SUBKEY_BACKUP"
}
trap cleanup EXIT

setup_gnupghome "$ENROLL_HOME"
export GNUPGHOME="$ENROLL_HOME"

open_usb "$DEVICE"

echo "==> Importing primary key from USB..."
"${GPG_BATCH[@]}" --import "$USB_MOUNT/primary-key.asc"

FINGERPRINT=$(gpg --list-keys --with-colons | awk -F: '/^fpr/ { print $10; exit }')
echo "==> Fingerprint: $FINGERPRINT"

echo "==> Creating subkey backup..."
"${GPG_BATCH[@]}" --armor --export-secret-subkeys "$FINGERPRINT" > "$SUBKEY_BACKUP"

program_all_yubikeys
