#!/bin/bash

set -o errexit
set -o nounset

refresh_cache=""
output_arg=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      echo "Build the USI (Unified System Image)." >&2
      echo "Usage: $0 [--refresh-cache] [output-device]" >&2
      echo "  Without an output device, builds to mkosi.images/usi/ for testing with mkosi vm." >&2
      echo "  --refresh-cache  Bust the mkosi incremental cache and do a full rebuild." >&2
      exit
      ;;
    --refresh-cache) refresh_cache="--incremental=no" ;;
    *) output_arg="$1" ;;
  esac
  shift
done

source bin/_luks_common.sh

if [[ -n "$output_arg" ]]; then
  mkosi \
    --directory=mkosi.images/usi \
    --output-directory="$PWD" \
    ${refresh_cache:+"$refresh_cache"} \
    burn "$output_arg"
else
  mkosi \
    --directory=mkosi.images/usi \
    --output-directory="$PWD" \
    ${refresh_cache:+"$refresh_cache"}
fi
