#!/bin/bash

set -o errexit
set -o nounset

hostname=""
runtime=qemu
recovery=""
mkosi_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      echo "Run the built image in a VM, setting its hostname at boot. Build it first with build-image." >&2
      echo "Usage: $0 --hostname=<hostname> [--runtime=qemu] [--recovery=IMAGE.raw] [mkosi options...]" >&2
      echo "  --hostname  Hostname, applied at boot via mkosi --machine (systemd.hostname=); required." >&2
      echo "  --runtime   VMM to use, passed to mkosi --vmm; default qemu." >&2
      echo "  --recovery  Raw disk image to attach as a second drive (e.g. a recovery image)." >&2
      echo "  Any other options are forwarded to mkosi (e.g. --console gui)." >&2
      exit
      ;;
    --hostname=*) hostname="${1#*=}" ;;
    --hostname) hostname="$2"; shift ;;
    --runtime=*) runtime="${1#*=}" ;;
    --runtime) runtime="$2"; shift ;;
    --recovery=*) recovery="${1#*=}" ;;
    --recovery) recovery="$2"; shift ;;
    *)
      mkosi_args+=("$1")
      if [[ "$1" =~ ^-- ]] && [[ $# -gt 1 && "$2" != -* ]]; then mkosi_args+=("$2"); shift; fi
      ;;
  esac
  shift
done

: "${hostname:?--hostname is required}"

shared_dir=.qemu-host-shared
output_dir=~/.cache/mkosi/images/image
mkdir -p "$shared_dir" "$output_dir"

vmm_args=()
if [[ "$runtime" == "qemu" ]]; then
  vmm_args+=(
    "-chardev" "socket,path=/tmp/qemu-guest-agent.sock,server=on,wait=off,id=qga0"
    "-device" "virtio-serial"
    "-device" "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"
  )
  if [[ -n "$recovery" ]]; then
    vmm_args+=(
      "-drive" "if=none,id=recovery,file=$recovery,format=raw"
      "-device" "scsi-hd,bus=scsi0.0,drive=recovery"
    )
  fi
fi

mkosi \
  --output-directory="$output_dir" \
  --machine="$hostname" \
  --vmm="$runtime" \
  --cpus=4 \
  --ram=4G \
  --vsock=yes \
  --vsock-cid=3 \
  --tpm=yes \
  --runtime-size=90G \
  --runtime-tree="$PWD/$shared_dir:/run/host/shared" \
  --profile=build \
  "${mkosi_args[@]}" \
  vm -- "${vmm_args[@]}"
