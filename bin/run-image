#!/bin/bash

set -o errexit
set -o nounset

runtime=qemu
device=""
boot_device=""
recovery_alias=""
mkosi_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      echo "Run the built image in a VM. Build it first with build-image." >&2
      echo "Usage: $0 [--runtime=qemu] [--device=DISK.raw] [mkosi options...]" >&2
      echo "  The machine names itself at first boot (mkosi Hostname=, machine-id derived)." >&2
      echo "  --runtime   VMM to use, passed to mkosi --vmm; default qemu." >&2
      echo "  --device    Attach DISK.raw as a second disk in the guest (/dev/vdb). At the boot" >&2
      echo "              menu, pick 'Live System (Recovery)' to repair it, or 'Installer' to" >&2
      echo "              install onto it. (--recovery is a deprecated alias.)" >&2
      echo "  --boot-device  Attach DISK.raw and boot IT instead of the medium (bootindex=0)." >&2
      echo "              Use to boot an already-installed target disk (its own first boot:" >&2
      echo "              provision + TPM2-seal). The medium stays attached as a fallback." >&2
      echo "  Any other options are forwarded to mkosi (e.g. --console gui)." >&2
      exit
      ;;
    --runtime=*) runtime="${1#*=}" ;;
    --runtime) runtime="$2"; shift ;;
    --device=*) device="${1#*=}" ;;
    --device) device="$2"; shift ;;
    --boot-device=*) boot_device="${1#*=}" ;;
    --boot-device) boot_device="$2"; shift ;;
    --recovery=*) device="${1#*=}"; recovery_alias=1 ;;
    --recovery) device="$2"; shift; recovery_alias=1 ;;
    *)
      mkosi_args+=("$1")
      if [[ "$1" =~ ^-- ]] && [[ $# -gt 1 && "$2" != -* ]]; then mkosi_args+=("$2"); shift; fi
      ;;
  esac
  shift
done

source bin/_cache_common.sh

shared_dir=.qemu-host-shared
output_dir="$ARCH_ANSIBLE_OUTPUT_DIR"
mkdir -p "$shared_dir" "$output_dir"

# mkosi maps the host user to root in the guest, so the runtime-tree share is
# only writable by root there. Make it world-writable on the host so the
# unprivileged guest user can write back through virtiofs too (the daemon
# performs the write as the host user who owns the dir).
chmod 0777 "$shared_dir"

vmm_args=()
if [[ "$runtime" == "qemu" ]]; then
  vmm_args+=(
    "-chardev" "socket,path=/tmp/qemu-guest-agent.sock,server=on,wait=off,id=qga0"
    "-device" "virtio-serial"
    "-device" "virtserialport,chardev=qga0,name=org.qemu.guest_agent.0"
  )
  if [[ -n "$device" ]]; then
    # Attach a second disk as an ordinary internal drive (no bootindex, so the
    # booted image stays the boot device). mkosi always boots the built image as
    # the medium; which role it plays is a boot-menu choice (see
    # mkosi.uki-profiles/): "Live System (Recovery)" to mount/repair this disk
    # (recovery-mount finds its LUKS), or "Installer" to replicate the image onto
    # it (systemd-sysinstall wipes and provisions it). Used as a blank target for
    # install, or a provisioned disk for recovery.
    [[ -n "$recovery_alias" ]] && echo "==> note: --recovery is a deprecated alias for --device." >&2
    vmm_args+=(
      "-drive" "if=none,id=device,file=$device,format=raw"
      "-device" "virtio-blk-pci,drive=device"
    )
    echo "==> Attached $device as /dev/vdb. At the boot menu, pick 'Live System" >&2
    echo "    (Recovery)' to repair it, or 'Installer' to install onto it." >&2
  fi
  if [[ -n "$boot_device" ]]; then
    # Attach an already-installed target and boot IT, not the medium. mkosi gives
    # the medium bootindex=1; bootindex=0 here is higher priority, so the firmware
    # boots this disk's own ESP/UKI first (the medium stays as a fallback). Use to
    # exercise the installed target's first boot (repart root/home/swap, TPM2-seal,
    # self-naming) which booting the medium can't reach.
    vmm_args+=(
      "-drive" "if=none,id=bootdevice,file=$boot_device,format=raw"
      "-device" "virtio-blk-pci,drive=bootdevice,bootindex=0"
    )
    echo "==> Booting $boot_device (bootindex=0), not the medium." >&2
  fi

  # With a GUI console, override mkosi's hardcoded SDL display (qemu.py uses
  # `-display sdl,gl=on`) with GTK. Only the GTK backend forwards window-resize
  # ui_info to the virtio-vga device, so the guest's Virtual-1 output follows
  # the host window size dynamically instead of staying at virtio-vga's default
  # 1024x768. zoom-to-fit=off makes it resize the guest rather than scale a
  # fixed framebuffer. This -display is appended after mkosi's; qemu honours the
  # last one. (Leave Virtual-1 unpinned in the sway config for this to work.)
  #
  # grab-on-hover=on grabs the keyboard whenever the pointer is over the window.
  # On Wayland that engages the keyboard-shortcuts-inhibit protocol, so the host
  # sway stops processing its own $mod bindings and Super (the sway mod key) is
  # delivered to the guest instead. With the host's focus_follows_mouse this
  # grabs whenever the VM is active. (Ctrl+Alt+G toggles the grab manually.)
  for a in "${mkosi_args[@]}"; do
    case "$a" in
      gui|--console=gui)
        vmm_args+=("-display" "gtk,gl=on,zoom-to-fit=off,grab-on-hover=on")
        # Absolute pointing device. Without it qemu gives the guest a relative
        # PS/2 mouse, so the guest cursor drifts out of sync with the host
        # pointer (looks invisible / unmovable) and clicks land in the wrong
        # place, so nothing selects. virtio-tablet reports absolute coordinates
        # so the guest cursor tracks the host pointer exactly.
        vmm_args+=("-device" "virtio-tablet")
        break
        ;;
    esac
  done

  # Persistent emulated TPM. mkosi's --tpm uses ephemeral per-run state, so a
  # TPM2-bound LUKS volume enrolled on first boot can't be unsealed on the next
  # boot ("key enrolled in superblock most likely does not belong to this
  # TPM"), and there's no passphrase fallback. Run our own swtpm against a
  # state dir next to the image so the TPM survives across runs, like real
  # hardware. (--tpm=no below disables mkosi's ephemeral one.)
  tpm_state="$output_dir/tpm"
  mkdir -p "$tpm_state"
  if [[ ! -e "$tpm_state/tpm2-00.permall" ]]; then
    # --createek makes the EK key only. Avoid --create-ek-cert/
    # --create-platform-cert: those invoke swtpm_localca, which needs
    # root-owned /var/lib/swtpm-localca. TPM2 LUKS sealing only needs a
    # working TPM with an SRK, not manufacturer EK/platform certs.
    swtpm_setup --tpm2 --tpmstate "$tpm_state" --createek
  fi
  swtpm socket --tpm2 --tpmstate "dir=$tpm_state" \
    --ctrl "type=unixio,path=$tpm_state/swtpm-sock" \
    --pid "file=$tpm_state/swtpm.pid" --daemon
  trap 'kill "$(cat "$tpm_state/swtpm.pid" 2>/dev/null)" 2>/dev/null || true' EXIT
  vmm_args+=(
    "-chardev" "socket,id=chrtpm,path=$tpm_state/swtpm-sock"
    "-tpmdev" "emulator,id=tpm0,chardev=chrtpm"
    "-device" "tpm-tis,tpmdev=tpm0"
  )

  # Pre-enroll our Secure Boot cert into the firmware varstore so the VM boots
  # already in user mode with Secure Boot on, like real hardware after its
  # one-time enrollment. We can't make this persist by handing mkosi a writable
  # varstore: finalize_firmware_variables() in mkosi/qemu.py always copies
  # --firmware-variables to a throwaway temp file and uses that as the pflash,
  # so the image's runtime auto-enroll (\loader\keys\auto) is discarded when the
  # VM exits. Every launch would re-enter setup mode, re-run enrollment, and
  # shift PCR 7 out from under the TPM2-bound LUKS keyslot. Instead we enroll the
  # cert into the varstore ourselves, up front, so the firmware is already in
  # user mode before the guest runs and PCR 7 is stable across launches; mkosi
  # then just copies the finished varstore (no re-enroll).
  #
  # mkosi's own --firmware-variables=custom does the same thing, but it shells
  # out to `virt-fw-vars --enroll-cert <file>`, which is broken in virt-firmware
  # 26.x: the path is routed through load_cert(), which only accepts builtin
  # "domain/name" refs and split('/')s it. The file-based --set-pk/--add-kek/
  # --add-db options take a real file, so we build the varstore directly.
  secureboot_cert="$ARCH_ANSIBLE_CACHE/mkosi-secureboot/mkosi.crt"
  if [[ ! -f "$secureboot_cert" ]]; then
    # Cache cleared but image still present: re-materialize the cert from pass.
    # This fallback is the only path here that touches GPG.
    source bin/_secureboot_common.sh
    materialize_secureboot_keypair
    secureboot_cert="$SECUREBOOT_CERT"
  fi
  ovmf_vars="$output_dir/ovmf_vars.fd"
  if [[ ! -f "$ovmf_vars" || "$secureboot_cert" -nt "$ovmf_vars" ]]; then
    virt-fw-vars \
      --input /usr/share/edk2/x64/OVMF_VARS.4m.fd \
      --output "$ovmf_vars" \
      --set-pk OvmfEnrollDefaultKeys "$secureboot_cert" \
      --add-kek OvmfEnrollDefaultKeys "$secureboot_cert" \
      --add-db OvmfEnrollDefaultKeys "$secureboot_cert" \
      --secure-boot
  fi
  mkosi_args+=(
    "--firmware=uefi-secure-boot"
    "--firmware-variables=$ovmf_vars"
  )

  # Networking backend. mkosi defaults to QEMU SLIRP (user-mode), whose
  # single-threaded userspace TCP stack collapses under parallel HTTPS — pacman's
  # ParallelDownloads=5 stalls the in-guest rebuild to ~0 B/s (a single stream is
  # fine). passt is the modern user-mode replacement: same rootless, WiFi-friendly
  # model (no bridge/tap, so it works over the host's wlan0 where --runtime-network
  # =interface can't) but a proper multi-threaded stack. --runtime-network=none
  # stops mkosi adding its own SLIRP nic; QEMU launches passt itself for the netdev.
  # Fall back to mkosi's SLIRP when passt isn't installed.
  if command -v passt >/dev/null 2>&1; then
    mkosi_args+=("--runtime-network=none")
    vmm_args+=(
      "-netdev" "passt,id=net0"
      "-device" "virtio-net-pci,netdev=net0"
    )
  fi
fi

# VM sizing. Rust/meson AUR rebuilds in the guest (e.g. pwvucontrol) scale
# almost linearly with vCPUs — cargo parallelizes to the core count — so default
# generously while leaving the host a couple of cores and headroom. Override per
# run with ARCH_ANSIBLE_VM_CPUS / ARCH_ANSIBLE_VM_RAM.
default_cpus=$(( $(nproc) > 4 ? $(nproc) - 2 : $(nproc) ))
vm_cpus="${ARCH_ANSIBLE_VM_CPUS:-$default_cpus}"
vm_ram="${ARCH_ANSIBLE_VM_RAM:-8G}"

mkosi \
  --output-directory="$output_dir" \
  --vmm="$runtime" \
  --cpus="$vm_cpus" \
  --ram="$vm_ram" \
  --vsock=yes \
  --vsock-cid=3 \
  --tpm=no \
  --runtime-size=90G \
  --runtime-tree="$PWD/$shared_dir:/run/host/shared" \
  --profile=build \
  "${mkosi_args[@]}" \
  vm -- "${vmm_args[@]}"
