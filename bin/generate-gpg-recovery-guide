#!/bin/bash
# Generates the printable recovery guide as a PDF: docs/recovery-guide.md with
# the docs it embeds, plus the key material from the primary key USB.
#
# Usage: bin/generate-gpg-recovery-guide <primary-key-usb-device> [output.pdf]
#        bin/generate-gpg-recovery-guide --preview [output.pdf]
#
# --preview prints placeholders in place of key material, so the layout can be
# checked without the USB. Run from the repo root.
#
# Store the PDF (or a printed copy) separately from the USB drives and YubiKeys.

set -o errexit
set -o nounset
set -o pipefail

source bin/_gpg_common.sh

GUIDE="docs/recovery-guide.md"
PUBKEY_FILE="ansible/roles/gpg/files/gpg-pubkey.asc"

DEVICE=""
if [[ "${1:-}" == "--preview" ]]; then
  OUTPUT="${2:-secrets/recovery-guide-preview.pdf}"
  RENDER_ARGS=(--preview)
else
  DEVICE="${1:?Usage: $0 (<primary-key-usb-device> | --preview) [output.pdf]}"
  OUTPUT="${2:-secrets/gpg-recovery-guide.pdf}"
fi

for f in "$GUIDE" "$PUBKEY_FILE"; do
  if [[ ! -f "$f" ]]; then
    echo "Error: $f not found — run from repo root." >&2
    exit 1
  fi
done

WORK=$(mktemp -d)
cleanup() {
  if [[ -n "$DEVICE" ]]; then close_usb; fi
  rm -rf "$WORK"
}
trap cleanup EXIT

if [[ -n "$DEVICE" ]]; then
  mkdir "$WORK/gnupg"
  setup_gnupghome "$WORK/gnupg"
  export GNUPGHOME="$WORK/gnupg"

  open_usb "$DEVICE"

  echo "==> Importing primary key..."
  gpg --batch --import "$USB_MOUNT/primary-key.asc"
  FINGERPRINT=$(gpg --list-keys --with-colons | awk -F: '/^fpr/{print $10; exit}')
  UID_STRING=$(gpg --list-keys --with-colons | awk -F: '/^uid/{print $10; exit}')

  # base16 carries a CRC per line, so paperkey names the line with a typo.
  echo "==> Encoding the private key with paperkey..."
  gpg --batch --export-secret-keys "$FINGERPRINT" \
    | paperkey --output-type base16 > "$WORK/paperkey.txt"

  RENDER_ARGS=(--uid "$UID_STRING" --fingerprint "$FINGERPRINT"
    --pubkey "$PUBKEY_FILE" --paperkey "$WORK/paperkey.txt")
  if [[ -f "$USB_MOUNT/oath-accounts.txt" ]]; then
    RENDER_ARGS+=(--oath "$USB_MOUNT/oath-accounts.txt")
  fi
fi

echo "==> Rendering $GUIDE..."
python3 bin/_recovery_guide.py "${RENDER_ARGS[@]}" --generated "$(date)" "$GUIDE" \
  > "$WORK/guide.html"

echo "==> Rendering PDF..."
mkdir -p "$(dirname "$OUTPUT")"
chromium --headless --disable-gpu --no-pdf-header-footer \
  --print-to-pdf="$OUTPUT" "$WORK/guide.html" 2>/dev/null

echo "==> Written to $OUTPUT"
