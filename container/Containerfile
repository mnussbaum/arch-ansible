# Disaster-recovery builder: builds the image (and nothing else) on any Linux
# or macOS machine with podman or docker. Run it through bin/dr-build, not
# directly; see docs/disaster-recovery.md.
#
# mkosi.build and mkosi.finalize run with this as their /usr (ToolsTree=/), so
# it carries their tools too (rust, sccache, rsync).
#
# x86_64 only, like the image. On an arm64 host it runs under Rosetta/qemu.
FROM docker.io/library/archlinux:latest

# The image is x86_64 whatever uname says under emulation.
RUN sed -i 's/^Architecture = auto/Architecture = x86_64/' /etc/pacman.conf \
 && printf 'Server = %s\n' \
      'https://geo.mirror.pkgbuild.com/$repo/os/$arch' \
      'https://fastly.mirror.pkgbuild.com/$repo/os/$arch' \
      > /etc/pacman.d/mirrorlist \
 && pacman -Syu --noconfirm --needed \
      base-devel \
      btrfs-progs \
      ccid \
      cpio \
      cryptsetup \
      curl \
      devtools \
      dosfstools \
      erofs-utils \
      git \
      gnupg \
      kmod \
      mkosi \
      mtools \
      openssh \
      openssl \
      pass \
      pcsclite \
      pinentry \
      python \
      python-cryptography \
      python-pefile \
      python-pystache \
      python-yaml \
      rsync \
      rust \
      sccache \
      sudo \
      systemd \
      systemd-ukify \
      tpm2-tss \
      zstd \
 && pacman -Scc --noconfirm

# mkosi and makepkg run as an unprivileged user, as bin/build-image does on a host.
RUN useradd --create-home --uid 1000 builder \
 && echo 'builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builder \
 && echo 'builder:100000:65536' > /etc/subuid \
 && echo 'builder:100000:65536' > /etc/subgid \
 && install -d -o builder -g builder /home/builder/.cache

COPY dr-entrypoint dr-unlock /usr/bin/

ENTRYPOINT ["/usr/bin/dr-entrypoint"]
