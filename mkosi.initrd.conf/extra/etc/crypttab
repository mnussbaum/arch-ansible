# Replaces gpt-auto's unit for the root volume, adding pkcs11-uri=auto: Arch's
# libcryptsetup has no token plugins (and gpt-auto's TPM2 measurement would
# disable them anyway), so systemd-cryptsetup only tries the PKCS#11 (YubiKey)
# slot when asked to. Swap stays TPM-only at boot: it is opened after
# switch-root, before the real system's pcscd can run. If the TPM breaks, swap
# is skipped for that boot and bin/luks-reseal-tpm re-seals it.
# noauto: only used when gpt-auto pulls in systemd-cryptsetup@root.service for a
# real root, so the Live/Installer profiles don't try to unlock attached disks.
root /dev/disk/by-designator/root-luks - tpm2-device=auto,pkcs11-uri=auto,tpm2-measure-pcr=yes,tpm2-measure-keyslot-nvpcr=yes,noauto
