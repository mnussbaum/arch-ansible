#!/bin/bash
# systemd-ask-password agent that surfaces prompts through zenity.
#
# Runs as root because the reply sockets in /run/systemd/ask-password/ are
# root-owned, so a user-level agent can't sendto() them ("Permission denied").
# zenity is launched in the active graphical user's session via runuser + the
# right XDG_RUNTIME_DIR / WAYLAND_DISPLAY, so the dialog appears in sway and
# the typed answer travels back to the root-issued ask request. zenity (rather
# than wofi/bemenu) because it natively renders a label + masked input in one
# dialog, matching what systemd's Message= is for.
#
# Protocol: https://systemd.io/PASSWORD_AGENTS/
set -o nounset

dir=/run/systemd/ask-password

active_wayland_user() {
  local d uid display
  for d in /run/user/*/; do
    uid=${d%/}; uid=${uid##*/}
    [[ $uid != 0 ]] || continue
    display=$(find "$d" -maxdepth 1 -name 'wayland-*' ! -name '*.lock' \
                -printf '%f\n' 2>/dev/null | sort | head -1)
    [[ -n $display ]] || continue
    printf '%s %s\n' "$uid" "$display"
    return 0
  done
  return 1
}

answer() {
  local ask=$1 line socket="" message="" pid=""
  while IFS= read -r line; do
    case $line in
      Socket=*)  socket=${line#Socket=} ;;
      Message=*) message=${line#Message=} ;;
      PID=*)     pid=${line#PID=} ;;
    esac
  done <"$ask"
  [[ -n $socket ]] || return 0

  # Body = systemd Message= + the asking process. For sudo/cryptsetup-style
  # callers the writing PID is systemd-ask-password itself; in that case fall
  # back to its parent's name, which is the actual originator (sudo, homed, ...).
  local text="${message:-Password required}"
  if [[ -n $pid ]]; then
    local cmd ppid pcmd
    cmd=$(ps -p "$pid" -o comm= 2>/dev/null | tr -d ' ')
    if [[ $cmd == *ask-pass* ]]; then
      ppid=$(ps -p "$pid" -o ppid= 2>/dev/null | tr -d ' ')
      pcmd=$(ps -p "$ppid" -o comm= 2>/dev/null | tr -d ' ')
      [[ -n $pcmd ]] && cmd=$pcmd
    fi
    [[ -n $cmd ]] && text+=$'\n\n'"Requested by: ${cmd}"
  fi

  local info uid display user home reply
  if ! info=$(active_wayland_user); then
    printf -- '-' | socat - "UNIX-SENDTO:$socket"
    return
  fi
  uid=${info% *}
  display=${info#* }
  user=$(getent passwd "$uid" | cut -d: -f1)
  home=$(getent passwd "$uid" | cut -d: -f6)

  # XDG_CONFIG_HOME=/etc/ask-password-agent layers our gtk-3.0/gtk.css user
  # override on top of Adwaita (kept as the base theme so widgets render
  # correctly), repainting the dialog with the active base16 palette via
  # @define-color overrides. The CSS is rendered from color_scheme_vars at
  # build time.
  if reply=$(runuser -u "$user" -- env \
        HOME="$home" XDG_CONFIG_HOME=/etc/ask-password-agent \
        XDG_RUNTIME_DIR="/run/user/$uid" WAYLAND_DISPLAY="$display" \
        zenity --entry --hide-text --title="systemd-ask-password" \
          --text="$text" </dev/null); then
    printf '+%s' "$reply" | socat - "UNIX-SENDTO:$socket"
  else
    printf -- '-' | socat - "UNIX-SENDTO:$socket"
  fi
  unset reply
}

for ask in "$dir"/ask.*; do
  [[ -e $ask ]] && answer "$ask" &
done

inotifywait -m -q -e create -e moved_to --format '%f' "$dir" |
while IFS= read -r name; do
  case $name in
    ask.*) answer "$dir/$name" & ;;
  esac
done
