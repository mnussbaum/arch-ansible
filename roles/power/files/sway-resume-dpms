#!/bin/sh
# After resume from hibernate, i915 takes time to reinitialize the display
# pipeline, causing wlroots atomic commits to return EBUSY for several minutes.
# Toggling DPMS forces sway to do a full re-modeset once the GPU is ready,
# which unblocks rendering without disabling atomic modesetting.

set -o errexit
set -o nounset
set -o pipefail

log() {
    logger -t sway-resume-dpms "$*"
}

graphical_session() {
    loginctl list-sessions --no-legend \
        | awk '$5 == "seat0" {print $1; exit}'
}

graphical_user() {
    loginctl list-sessions --no-legend \
        | awk '$5 == "seat0" {print $3; exit}'
}

case "$1" in
    post)
        user=$(graphical_user) || true
        if [ -z "$user" ]; then
            log "post: no graphical user session found"
            exit 0
        fi
        uid=$(id -u "$user")
        swaysock=$(ls /run/user/"$uid"/sway-ipc.*.sock 2>/dev/null | head -1) || true
        if [ -z "$swaysock" ]; then
            log "post: no sway socket found for user=$user"
            exit 0
        fi
        session=$(graphical_session)
        log "post: scheduling DPMS toggle (user=$user session=$session)"
        # Spawn the retry loop as an independent transient unit so it survives
        # past systemd-suspend-then-hibernate.service exit. A bare & subshell
        # is killed when systemd cleans up the sleep service's cgroup (~3s after
        # the post hook fires), before the first swaymsg attempt can run.
        systemd-run --no-block --collect \
            /usr/lib/systemd/system-sleep/sway-resume-dpms dpms-toggle "$user" "$swaysock" "$session"
        ;;
    dpms-toggle)
        user="$2"
        swaysock="$3"
        session="$4"
        # Re-activate the logind session to ensure sway has DRM master.
        # After hibernate, libseat logs "Could not close device: Device not taken"
        # errors, indicating logind's session state is confused and sway may lack
        # DRM master. loginctl activate re-establishes the session handoff.
        log "dpms-toggle: activating session $session to restore DRM master"
        loginctl activate "$session"
        sleep 3
        attempt=0
        while [ "$attempt" -lt 20 ]; do
            attempt=$((attempt + 1))
            if su -c "swaymsg -s '$swaysock' 'output * dpms off'" "$user" 2>/dev/null; then
                log "dpms off succeeded (attempt $attempt)"
                sleep 1
                su -c "swaymsg -s '$swaysock' 'output * dpms on'" "$user" \
                    || log "dpms on failed"
                log "DPMS toggle complete"
                exit 0
            fi
            log "dpms off not ready (attempt $attempt), retrying"
            sleep 3
        done
        log "dpms toggle failed after 20 attempts"
        ;;
esac
