[Unit]
Description=Lock screen after 5 min idle and sleep after 10 min idle
Documentation=man:swayidle(1) man:swaylock(1)
PartOf=graphical-session.target

[Service]
# -w blocks swayidle on every command, so swaylock must daemonize (-f) once
# locked; a foreground swaylock stalls swayidle until unlock, then it replays
# the queued idle/sleep events and relocks. pgrep avoids stacking lockers.
ExecStart=swayidle -w \
    timeout {{ idle_thresholds["lock_screen_delay_minutes"] * 60 }} "pgrep -x swaylock || (chayang && swaylock -f)" \
    timeout {{ idle_thresholds["suspend_delay_minutes"] * 60 }} "systemctl suspend-then-hibernate" \
    before-sleep "pgrep -x swaylock || swaylock -f"
Restart=on-failure
RestartSec=1
TimeoutStopSec=10

[Install]
WantedBy=sway-session.target
