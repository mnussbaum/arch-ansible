#!/usr/bin/env python3
"""Backup/restore wrapper around restic for a homed user's btrfs home.

Subcommands:
    backup     Snapshot home (btrfs ro snapshot), back up included paths.
    restore    Restore included paths from a snapshot.
    snapshots  List snapshots in the repository.
    mount      FUSE-mount the repository for browsing.

Default repository is Backblaze B2. Pass --device /dev/sdXN on any
subcommand to operate against a restic repo on a local block device
instead (mounted via udisksctl, repo at <mount>/restic-repo).

Credentials are read from $CREDENTIALS_DIRECTORY when running under
systemd, otherwise fetched from `pass`.
"""

import argparse
import contextlib
import os
import pathlib
import pwd
import shutil
import socket
import subprocess
import sys
import tempfile

B2_REPOSITORY = "b2:mnussbaum-machine-backups"
DEVICE_REPO_SUBDIR = "restic-repo"
SNAPSHOT_DIRNAME = ".snapshots"
SNAPSHOT_NAME = "restic-current"

CONFIG_DIR = pathlib.Path("/etc/restic-backup")
INCLUDES_FILE = CONFIG_DIR / "includes"
EXCLUDES_FILE = CONFIG_DIR / "excludes"


def hostname() -> str:
    return socket.gethostname()


def notify(urgency: str, summary: str, body: str = "") -> None:
    """Send a desktop notification; soft-fails if notify-send is missing."""
    try:
        subprocess.run(
            [
                "notify-send",
                f"--urgency={urgency}",
                "--app-name=Restic Backup",
                "--expire-time=8000",
                summary, body,
            ],
            check=False,
        )
    except FileNotFoundError:
        pass


def home_dir(username: str) -> pathlib.Path:
    return pathlib.Path(pwd.getpwnam(username).pw_dir)


def credential(name: str) -> str:
    creds_dir = os.environ.get("CREDENTIALS_DIRECTORY")
    if creds_dir:
        path = pathlib.Path(creds_dir) / name
        if path.exists():
            return path.read_text().rstrip("\n")
    pass_paths = {
        "restic_backblaze_key":
            f"host_secrets/{hostname()}/restic_backblaze_key",
        "restic_backblaze_key_id":
            f"host_secrets/{hostname()}/restic_backblaze_key_id",
        "restic_backup_password": "restic_backup_password",
    }
    r = subprocess.run(
        ["pass", "show", pass_paths[name]],
        capture_output=True, text=True, check=True,
    )
    return r.stdout.rstrip("\n")


def read_lines(path: pathlib.Path) -> list[str]:
    out: list[str] = []
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        out.append(line)
    return out


def mountpoint_of(device: str) -> pathlib.Path | None:
    r = subprocess.run(
        ["findmnt", "-no", "TARGET", device],
        capture_output=True, text=True,
    )
    target = r.stdout.strip()
    return pathlib.Path(target) if r.returncode == 0 and target else None


@contextlib.contextmanager
def mounted_device(device: str):
    existing = mountpoint_of(device)
    if existing is not None:
        yield existing
        return
    subprocess.run(
        ["udisksctl", "mount", "-b", device, "--no-user-interaction"],
        check=True,
    )
    mnt = mountpoint_of(device)
    if mnt is None:
        sys.exit(f"Could not determine mountpoint for {device} after mount")
    try:
        yield mnt
    finally:
        subprocess.run(
            ["udisksctl", "unmount", "-b", device, "--no-user-interaction"],
            check=False,
        )


@contextlib.contextmanager
def repo_env(device: str | None):
    env = os.environ.copy()
    env["RESTIC_PASSWORD"] = credential("restic_backup_password")
    if device:
        with mounted_device(device) as mnt:
            repo = mnt / DEVICE_REPO_SUBDIR
            if not repo.exists():
                sys.exit(
                    f"No restic repo at {repo}. Initialize first with:\n"
                    f"  RESTIC_PASSWORD_FILE=<path> restic init --repo {repo}"
                )
            env["RESTIC_REPOSITORY"] = str(repo)
            yield env
    else:
        env["RESTIC_REPOSITORY"] = B2_REPOSITORY
        env["B2_ACCOUNT_ID"] = credential("restic_backblaze_key_id")
        env["B2_ACCOUNT_KEY"] = credential("restic_backblaze_key")
        yield env


def btrfs(*args: str) -> None:
    subprocess.run(["btrfs", *args], check=True)


@contextlib.contextmanager
def btrfs_snapshot(home: pathlib.Path):
    snaps_dir = home / SNAPSHOT_DIRNAME
    snaps_dir.mkdir(exist_ok=True)
    snap = snaps_dir / SNAPSHOT_NAME
    if snap.exists():
        btrfs("subvolume", "delete", str(snap))
    btrfs("subvolume", "snapshot", "-r", str(home), str(snap))
    try:
        yield snap
    finally:
        subprocess.run(
            ["btrfs", "subvolume", "delete", str(snap)],
            check=False,
        )


def resolve_targets(snap: pathlib.Path, includes: list[str]) -> list[pathlib.Path]:
    out: list[pathlib.Path] = []
    for rel in includes:
        p = snap / rel.lstrip("/")
        if not p.exists():
            print(f"skipping missing include: {rel}", file=sys.stderr)
            continue
        out.append(p)
    return out


def cmd_backup(args: argparse.Namespace) -> None:
    notify("normal", "Backup starting",
           "You might be prompted for credentials")
    try:
        home = home_dir(args.user)
        if not home.is_dir():
            sys.exit(f"Home dir {home} not found; is the home activated?")

        includes = args.directory or read_lines(INCLUDES_FILE)

        with repo_env(args.device) as env, btrfs_snapshot(home) as snap:
            targets = resolve_targets(snap, includes)
            if not targets:
                sys.exit("Nothing to back up: no included paths exist in the snapshot")
            cmd = [
                "restic", "backup",
                "--compression", "max",
                "--exclude-caches",
                "--one-file-system",
                "--cleanup-cache",
                "--exclude-file", str(EXCLUDES_FILE),
                "--tag", f"user={args.user}",
                "--tag", f"host={hostname()}",
                *[str(t) for t in targets],
            ]
            subprocess.run(cmd, check=True, env=env)
    except BaseException:
        notify("critical", "Backup failed",
               "Check journal: journalctl --user -u restic-backup")
        raise
    notify("normal", "Backup complete", "")


def cmd_restore(args: argparse.Namespace) -> None:
    home = home_dir(args.user)
    target = pathlib.Path(args.target) if args.target else home
    target.mkdir(parents=True, exist_ok=True)
    snap_root = home / SNAPSHOT_DIRNAME / SNAPSHOT_NAME

    includes = args.directory or read_lines(INCLUDES_FILE)

    # Staging dir is inside target so the post-restore move is a same-FS
    # rename (cheap on btrfs) rather than a cross-FS copy.
    staging = pathlib.Path(tempfile.mkdtemp(
        prefix=".restic-restore-", dir=str(target),
    ))
    try:
        with repo_env(args.device) as env:
            for rel in includes:
                rel = rel.lstrip("/")
                src_in_snap = snap_root / rel
                print(f"Restoring {rel} ...", file=sys.stderr)
                subprocess.run(
                    [
                        "restic", "restore", args.snapshot,
                        "--target", str(staging),
                        "--include", str(src_in_snap),
                    ],
                    check=True, env=env,
                )
                staged = staging / str(src_in_snap).lstrip("/")
                dst = target / rel
                if not staged.exists():
                    print(f"  warning: {rel} not present in snapshot",
                          file=sys.stderr)
                    continue
                dst.parent.mkdir(parents=True, exist_ok=True)
                if dst.exists():
                    sys.exit(
                        f"{dst} already exists; remove it first or pass "
                        f"--target to restore elsewhere"
                    )
                staged.rename(dst)
    finally:
        if staging.exists():
            shutil.rmtree(staging, ignore_errors=True)


def cmd_snapshots(args: argparse.Namespace) -> None:
    with repo_env(args.device) as env:
        subprocess.run(
            ["restic", "snapshots", *args.restic_args],
            check=True, env=env,
        )


def cmd_mount(args: argparse.Namespace) -> None:
    mnt = pathlib.Path(args.mountpoint)
    mnt.mkdir(parents=True, exist_ok=True)
    with repo_env(args.device) as env:
        subprocess.run(
            ["restic", "mount", str(mnt), *args.restic_args],
            check=True, env=env,
        )


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        description=__doc__.splitlines()[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="command", required=True)

    def add_device(sp: argparse.ArgumentParser) -> None:
        sp.add_argument(
            "--device",
            help="Local block device (e.g. /dev/sda1) to use as repo. "
                 "Defaults to Backblaze B2.",
        )

    default_user = os.environ.get("USER") or pwd.getpwuid(os.getuid()).pw_name

    sp = sub.add_parser("backup", help="Snapshot home and back it up.")
    sp.add_argument("user", nargs="?", default=default_user,
                    help=f"User whose home to back up (default: {default_user})")
    sp.add_argument("--directory", "-d", action="append", default=[],
                    help="Path relative to home to back up (repeatable). "
                         f"Default: contents of {INCLUDES_FILE}.")
    add_device(sp)
    sp.set_defaults(func=cmd_backup)

    sp = sub.add_parser("restore", help="Restore from a snapshot.")
    sp.add_argument("user", nargs="?", default=default_user,
                    help=f"User whose home to restore (default: {default_user})")
    sp.add_argument("--snapshot", default="latest",
                    help="Snapshot ID to restore (default: latest)")
    sp.add_argument("--directory", "-d", action="append", default=[],
                    help="Path relative to home to restore (repeatable). "
                         f"Default: contents of {INCLUDES_FILE}.")
    sp.add_argument("--target",
                    help="Restore target dir (default: user's home).")
    add_device(sp)
    sp.set_defaults(func=cmd_restore)

    sp = sub.add_parser("snapshots", help="List snapshots in the repository.")
    add_device(sp)
    sp.add_argument("restic_args", nargs=argparse.REMAINDER,
                    help="Extra args forwarded to `restic snapshots`")
    sp.set_defaults(func=cmd_snapshots)

    sp = sub.add_parser("mount", help="FUSE-mount the repository.")
    sp.add_argument("mountpoint", help="Empty directory to mount onto.")
    add_device(sp)
    sp.add_argument("restic_args", nargs=argparse.REMAINDER,
                    help="Extra args forwarded to `restic mount`")
    sp.set_defaults(func=cmd_mount)

    return p


def main() -> None:
    args = build_parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
