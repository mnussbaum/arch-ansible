#!/bin/bash
set -euo pipefail

ROOT_MAPPER=$(findmnt --noheadings --output=SOURCE /)
DEVICE=$(cryptsetup status "${ROOT_MAPPER##*/}" | awk '/device:/{print $2}')

echo "Plug in YubiKey and press enter..."
read -r
systemd-cryptenroll --fido2-device=auto "$DEVICE"
echo "Done. Run again for each additional YubiKey."
