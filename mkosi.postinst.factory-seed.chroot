#!/bin/bash
# Move /etc contents into /usr/share/factory/etc and generate tmpfiles.d
# rules that symlink /etc back into factory on first boot. Runs after the
# Ansible postinst-playbook has populated /etc.
#
# After this script: /etc on the built root partition is empty (modulo the
# allowlist). On first boot, systemd-tmpfiles-setup.service replays the L
# (symlink) lines below to create /etc/<thing> as a symlink to
# /usr/share/factory/etc/<thing>. This makes /etc *track* /usr across A/B
# updates instead of freezing at first boot.
#
# Per-host state (machine-id, ssh host keys, shadow) is generated by stock
# systemd services into the writable /etc and replaces the symlinks at those
# specific paths.

set -euo pipefail

[[ -n "${SKIP_POSTINST:-}" ]] && exit 0

FACTORY=/usr/share/factory/etc
TMPFILES=/usr/lib/tmpfiles.d/00-factory-etc.conf

# Top-level /etc entries that stay in place (NOT moved to factory). Used for
# things that must be writable before systemd-tmpfiles runs, or that we want
# the running system to own outright. Keep this list short and document each
# entry with a one-line rationale.
ALLOWLIST=(
    # systemd-cryptsetup@var.service runs before tmpfiles-setup, so the LUKS
    # keyfile for /var must be on the root partition already at unlock time.
    # Removed in A.4 when /var becomes a btrfs subvolume of root with TPM2.
    cryptsetup-keys.d
)

# Top-level /etc entries that are removed entirely. Used for sensitive
# build-time artifacts that must not ship, and for state that the running
# system regenerates on first boot.
DROPLIST=(
    # ukify's signing private key — used at build time, must not ship
    kernel/secure-boot-private-key.pem
    # pacman keyring — regenerated on first boot;
    # shipping the build-host keyring would tie every machine to one trustdb
    pacman.d/gnupg
    # makepkg.conf is mutated for the nspawn build chroot; those mutations
    # must not persist into the running image. Dropping the file outright is
    # acceptable because the running system does not invoke makepkg/yay
    makepkg.conf
)

is_listed() {
    local needle="$1" hay
    shift
    for hay in "$@"; do
        [[ "$needle" == "$hay" || "$needle" == "$hay"/* ]] && return 0
    done
    return 1
}

# Drop sensitive build-time-only files first.
for rel in "${DROPLIST[@]}"; do
    rm -rf -- "/etc/$rel"
done

mkdir -p "$FACTORY" "$(dirname "$TMPFILES")"

{
    echo "# Auto-generated by mkosi.postinst.factory-seed.chroot"
    echo "# Symlinks /etc/<thing> -> /usr/share/factory/etc/<thing>."
    echo "# Using L (symlink) lines, not C (copy), so /etc tracks /usr"
    echo "# across A/B updates. The default target (the trailing '-' in"
    echo "# place of an explicit path) makes tmpfiles compute the canonical"
    echo "# /usr/share/factory/<path> target automatically."
    echo ""
} > "$TMPFILES"

shopt -s nullglob dotglob
for entry in /etc/*; do
    name=$(basename "$entry")

    if is_listed "$name" "${ALLOWLIST[@]}"; then
        continue
    fi

    # Move the real content into factory. Whether the source is a file,
    # directory, or symlink doesn't matter — the L-line creates a symlink at
    # /etc/<name> pointing at /usr/share/factory/etc/<name>, and tmpfiles
    # resolves the target type at access time.
    mv "$entry" "$FACTORY/$name"
    printf 'L /etc/%s - - - - -\n' "$name" >> "$TMPFILES"
done

# Sanity: assert /etc is empty modulo the allowlist.
remaining=()
while IFS= read -r -d '' path; do
    name=$(basename "$path")
    is_listed "$name" "${ALLOWLIST[@]}" && continue
    remaining+=("$name")
done < <(find /etc -mindepth 1 -maxdepth 1 -print0)

if (( ${#remaining[@]} )); then
    echo "ERROR: /etc not empty after factory conversion:" >&2
    printf '  /etc/%s\n' "${remaining[@]}" >&2
    exit 1
fi

# Sanity: verify the generated tmpfiles rules parse cleanly.
systemd-tmpfiles --dry-run --create "$TMPFILES" >/dev/null
