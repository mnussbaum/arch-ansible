Defaults timestamp_timeout=30

%wheel ALL=(ALL) ALL
%wheel ALL=(ALL) NOPASSWD: /usr/bin/pacman
%wheel ALL=(ALL) NOPASSWD: /usr/bin/homectl
# Encrypt-and-store only (never decrypts); see the script.
%wheel ALL=(ALL) NOPASSWD: /usr/bin/store-wifi-credential
# Only enrolls a token on, and drops the password of, the caller's home.
%wheel ALL=(ALL) NOPASSWD: /usr/bin/home-enroll-yubikey
# Only wipes the baked initial home secret's keyslot; see the script.
%wheel ALL=(ALL) NOPASSWD: /usr/bin/home-drop-baked-secret
