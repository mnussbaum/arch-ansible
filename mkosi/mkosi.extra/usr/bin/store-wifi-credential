#!/bin/bash
# Store an iwd network profile as a credential encrypted to this machine (host
# key + TPM2, no PCRs), or restart iwd to load them. Run as root via sudo by the
# first-login playbook.
#
#   store-wifi-credential PROFILE < profile-contents
#   store-wifi-credential --restart-iwd
#
# Deliberately narrow, since wheel may run it without a password: it only
# encrypts, and only writes /etc/credstore.encrypted/iwd.network.*.
set -o errexit
set -o nounset
set -o pipefail

[[ $EUID -eq 0 ]] || { echo "error: run as root" >&2; exit 1; }

if [[ "${1:-}" == --restart-iwd ]]; then
    exec systemctl try-restart iwd.service
fi

profile="${1:?usage: $0 PROFILE < contents | $0 --restart-iwd}"
# No path separators or leading dot, and one of iwd's profile suffixes; the
# rest (spaces, "=", punctuation) is legal in an SSID and a file name.
if [[ "$profile" == */* || "$profile" == .* \
      || ! "$profile" =~ \.(psk|8021x|open)$ ]]; then
    echo "error: '$profile' is not an iwd profile file name" >&2
    exit 2
fi

dir=/etc/credstore.encrypted
name="iwd.network.$profile"
install -d -m 0700 "$dir"
systemd-creds encrypt --with-key=host+tpm2 --name="$name" - "$dir/$name"
chmod 0600 "$dir/$name"
echo "stored $name" >&2
