#!/bin/bash
# Store an iwd network profile as a credential encrypted to this machine (host
# key only), or restart iwd to load them. Run as root via sudo by the
# first-login playbook. Not TPM2: iwd.service decrypts every profile serially
# before it starts, and each TPM2 unseal costs over a second of boot.
#
#   store-wifi-credential PROFILE < profile-contents
#   store-wifi-credential --restart-iwd
#
# Deliberately narrow, since wheel may run it without a password: it only
# encrypts, decrypts only to compare against the new contents, and only writes
# /etc/credstore.encrypted/iwd.network.*.
set -o errexit
set -o nounset
set -o pipefail

[[ $EUID -eq 0 ]] || { echo "error: run as root" >&2; exit 1; }

if [[ "${1:-}" == --restart-iwd ]]; then
    exec systemctl try-restart iwd.service
fi

profile="${1:?usage: $0 PROFILE < contents | $0 --restart-iwd}"
# No path separators or leading dot, and one of iwd's profile suffixes; the
# rest (spaces, "=", punctuation) is legal in an SSID and a file name.
if [[ "$profile" == */* || "$profile" == .* \
      || ! "$profile" =~ \.(psk|8021x|open)$ ]]; then
    echo "error: '$profile' is not an iwd profile file name" >&2
    exit 2
fi

dir=/etc/credstore.encrypted
name="iwd.network.$profile"
# systemd's CRED_AES256_GCM_BY_HOST, the first 16 bytes of a host-key credential.
host_key_id=5a1c6a86df9d4096b1d5a65e0862f19a
IFS= read -r -d '' contents || true

# Encryption isn't deterministic, so compare plaintext to report "unchanged"
# and let the caller skip restarting iwd. Any decrypt failure, or a credential
# sealed with another key (e.g. TPM2), re-encrypts.
if [[ -e "$dir/$name" ]] \
    && [[ "$(base64 -d < "$dir/$name" 2>/dev/null | head -c 16 \
            | od -An -tx1 | tr -d ' \n')" == "$host_key_id" ]] \
    && cmp -s \
    <(systemd-creds decrypt --name="$name" "$dir/$name" - 2>/dev/null) \
    <(printf '%s' "$contents"); then
    echo "unchanged $name" >&2
    exit 0
fi

install -d -m 0700 "$dir"
printf '%s' "$contents" \
    | systemd-creds encrypt --with-key=host --name="$name" - "$dir/$name"
chmod 0600 "$dir/$name"
echo "stored $name" >&2
