#!/bin/bash
# Enroll the shared YubiKey PIV key (slot 9d) on root, swap and home as a PKCS#11
# unlock, authorized by their volume keys (luks-volume-key), since their TPM2
# slots only unseal in the initrd. Every YubiKey bin/enroll-yubikeys
# provisions carries the same key, so any of them, including future ones,
# unlocks the disk. Enrolling asks for the PIV PIN (to read the certificate)
# but no touch. Run at first boot by luks-enroll-pkcs11.service; safe to
# re-run, since volumes that already have a PKCS#11 slot are skipped.
#
# Without this slot the TPM is a volume's only factor, and any TPM failure
# makes it unrecoverable. So it never gives up on its own: it waits for a
# YubiKey until one is enrolled or "skip" is typed, and exits non-zero (the
# system shows degraded) while a volume is left without the slot.
set -o errexit
set -o nounset
set -o pipefail

# Card-agnostic, like the homed enrollment in ansible/roles/user/tasks/first-login.yml:
# no serial or token label, so the slot matches whichever YubiKey is plugged in.
uri='pkcs11:model=PKCS%2315%20emulated;manufacturer=piv_II;id=%03'

# To the console and the journal: the outcome has to be findable after the fact.
say() {
    printf '\n==> %s\n' "$*"
    logger -t luks-enroll-pkcs11 -- "$*" 2>/dev/null || true
}

has_pkcs11() { systemd-cryptenroll "$1" 2>/dev/null | grep -qw pkcs11; }
have_key() { systemd-cryptenroll --pkcs11-token-uri=list 2>/dev/null | grep -q '^pkcs11:'; }

devices=()
for d in /dev/disk/by-designator/{root,swap,home}-luks; do
    [[ -e "$d" ]] && ! has_pkcs11 "$d" && devices+=("$d")
done
[[ ${#devices[@]} -gt 0 ]] || exit 0

# A VM only has a YubiKey if one was passed through (bin/vm --yubikey); don't
# hold its first boot waiting for one, beyond pcscd's first reader scan.
if systemd-detect-virt --quiet --vm; then
    for (( i = 0; i < 10; i++ )); do
        have_key && break
        sleep 1
    done
    have_key || { say "VM without a YubiKey; not enrolling."; exit 0; }
fi

# Give a key that's already plugged in a moment for pcscd's first reader scan.
for (( i = 0; i < 10; i++ )); do
    have_key && break
    sleep 1
done
while ! have_key; do
    say "No YubiKey found. Without one, a TPM failure makes this disk unrecoverable."
    read -rp "Plug in a YubiKey and press Enter, or type skip to continue without: " reply
    if [[ "$reply" == skip ]]; then
        say "Skipped YubiKey enrollment. Enroll later with: sudo $0"
        exit 1
    fi
done

key=
trap '[[ -z "$key" ]] || luks-volume-key remove "$dev" "$key"' EXIT
for dev in "${devices[@]}"; do
    name=${dev##*/}
    if ! key=$(luks-volume-key add "$dev"); then
        # luks-forget-volume-keys.service keeps them on boots that start with
        # a volume lacking the slot.
        say "Can't authorize enrolling ${name%-luks} this boot; reboot and re-run."
        key=
        continue
    fi
    while true; do
        say "Enrolling the YubiKey for ${name%-luks}; enter its PIV PIN when asked."
        if systemd-cryptenroll "$dev" --unlock-key-file="$key" --pkcs11-token-uri="$uri"; then
            say "YubiKey PIV key enrolled for ${name%-luks}."
            break
        fi
        # Ask rather than retry automatically: each wrong PIN uses up one of
        # the PIV applet's few attempts.
        read -rp "Enrollment failed. Press Enter to retry, or type skip: " reply
        [[ "$reply" == skip ]] && break
    done
    luks-volume-key remove "$dev" "$key"
    key=
done

rc=0
for dev in "${devices[@]}"; do
    if ! has_pkcs11 "$dev"; then
        say "WARNING: ${dev##*/} has no YubiKey slot. Enroll later with: sudo $0"
        rc=1
    fi
done
# Every volume has its slot again, so the volume keys can go
# (luks-forget-volume-keys.service, bin/revoke-luks-yubikey).
(( rc )) || rm -f /var/lib/arch-ansible/keep-volume-keys
exit "$rc"
