#!/bin/bash
# Wipe the keyslot of a homed home's baked initial secret, which sits readable in
# every image's unencrypted /usr (bin/_credstore_common.sh), once the YubiKey is
# enrolled. Run as root via sudo by the first-login playbook, on an active home.
#
#   home-drop-baked-secret [USER]   (default: the sudo caller)
#
# Deliberately narrow, since wheel may run it without a password: it only ever
# wipes the slot the baked secret opens, and only when the YubiKey's slot exists
# beside it. Prints "removed" or "unchanged".
set -o errexit
set -o nounset
set -o pipefail

[[ $EUID -eq 0 ]] || { echo "error: run as root" >&2; exit 1; }
user=${1:-${SUDO_USER:?usage: $0 USER}}
[[ $user =~ ^[a-z_][a-z0-9_-]*$ ]] || { echo "error: bad user name '$user'" >&2; exit 2; }
baked=/usr/lib/credstore/home.new-password

# The LUKS volume of the active home's image: the loop device itself or, when
# attached with partitions, its partition.
loop=$(losetup -nO NAME -j "/home/$user.home" | head -1)
[[ -n $loop ]] || { echo "error: the home of $user is not active" >&2; exit 1; }
part=$(lsblk -nrpo NAME,FSTYPE "$loop" | awk '$2 == "crypto_LUKS" {print $1; exit}')
[[ -n $part ]] || { echo "error: no LUKS volume in $loop" >&2; exit 1; }

# Exit code 2 is a passphrase that opens no slot; anything else is a real error.
rc=0
out=$(cryptsetup open --test-passphrase --verbose --key-file="$baked" "$part" 2>&1) || rc=$?
if (( rc == 2 )); then echo unchanged; exit 0; fi
(( rc == 0 )) || { echo "error: cryptsetup failed ($rc): $out" >&2; exit 1; }
slot=$(sed -n 's/^Key slot \([0-9]*\) unlocked.*/\1/p' <<<"$out")
[[ -n $slot ]] || { echo "error: no slot in cryptsetup's output: $out" >&2; exit 1; }

# Never the last keyslot: the token's must exist besides it.
homectl inspect "$user" --json=short | grep -q '"pkcs11EncryptedKey"' \
  || { echo "error: no YubiKey enrolled on $user's home; keeping the baked secret" >&2; exit 1; }
slots=$(cryptsetup luksDump --dump-json-metadata "$part" \
  | python3 -c 'import json, sys; print(len(json.load(sys.stdin)["keyslots"]))')
(( slots > 1 )) || { echo "error: the baked secret holds the only keyslot" >&2; exit 1; }

# Without a passphrase on stdin, --batch-mode wipes without asking for one.
cryptsetup luksKillSlot --batch-mode "$part" "$slot" </dev/null
echo removed
